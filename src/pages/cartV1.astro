---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import BigButton from "../components/BigButton.astro";

import Cross from "../assets/icons/product-card/cross.svg";
import Trash from "../assets/icons/trash.svg";

const myPath = [
    { text: "главное", href: "#" },
    { text: "корзина", href: "#" },
];
---

<Layout>
    <Header />
    <Nav items={myPath} />
    <section class="basket-section-container">
        <div class="header-container">
            <div class="header-container__info">
                <h2>корзина<sup>(2)</sup></h2>
                <p>
                    Здесь собраны все товары, которые вы выбрали для покупки.
                    Проверьте состав заказа перед оформлением.
                </p>
            </div>
            <div class="header-container__order">
                <h3>оформление заказа</h3>
                <span>Y44568RT</span>
            </div>
        </div>
        <div class="container">
            <!-- Cart Section -->
            <div class="cart">
                <div class="cart-head">
                    <a href="#">&lt;&lt; вернуться к покупкам</a>
                    <button class="btn">
                        <Trash width={16} height={16} />
                        <span>очистить корзину </span>
                    </button>
                </div>
                <!-- Product 1 -->
                <div class="cart-product">
                    <img
                        src="https://www.intel.com/content/dam/logos/logos-16x9/intel-core-i3-logo-16x9.png.rendition.intel.web.480.270.png"
                        alt="Intel i3"
                    />
                    <div class="cart-product-details">
                        <div class="product-title">
                            INTEL CORE I3 10100F OEM CM8070104482913 I8
                        </div>
                        <div class="product-row">
                            <div>Самовывоз: 38 шт.</div>
                            <div>Доставка: //</div>
                            <div>8 августа</div>
                        </div>
                        <div class="product-art">АРТИКУЛ: 1654298</div>
                        <div class="product-price">9 300Р</div>
                    </div>
                    <div class="cart-product-actions">
                        <input
                            type="number"
                            class="quantity"
                            min="1"
                            value="1"
                        />
                        <button class="remove-btn" title="Удалить"
                            >&#128465;</button
                        >
                    </div>
                </div>
                <!-- Product 2 -->
                <div class="cart-product">
                    <img
                        src="https://static.dns-shop.ru//img/goods/2021/7/12/880a040b2f13cc7ce60eaa5a14127eea.jpg"
                        alt="GPU"
                    />
                    <div class="cart-product-details">
                        <div class="product-title">
                            ВИДЕОКАРТА GAINWARD (NE63070019P2-1060H) GEFORCE RTX
                            3070 8GB PHTOM III
                        </div>
                        <div class="product-row">
                            <div>Самовывоз: 30 шт.</div>
                            <div>Доставка: //</div>
                            <div>8 августа</div>
                        </div>
                        <div class="product-art">АРТИКУЛ: 1654298</div>
                        <div class="product-price">12 850Р</div>
                    </div>
                    <div class="cart-product-actions">
                        <input
                            type="number"
                            class="quantity"
                            min="1"
                            value="1"
                        />
                        <button class="remove-btn" title="Удалить"
                            >&#128465;</button
                        >
                    </div>
                </div>
                <!-- Optionals -->
                <div class="optionals">
                    <span>дополнительно://</span>
                    <label>
                        <span class="switch">
                            <input type="checkbox" checked />
                            <span class="slider"></span>
                        </span>
                        Проверка на запуск при самовывозе (+ 270 руб)
                    </label>
                    <label>
                        <span class="switch">
                            <input type="checkbox" />
                            <span class="slider"></span>
                        </span>
                        сборка пк
                    </label>
                </div>
                <!-- Contacts Help -->
                <div class="contacts-block angles">
                    <h4>Возникли сложности с оформлением заказа?</h4>
                    <p>
                        Если у вас появились вопросы или что‑то не получается —
                        мы всегда на связи. Напишите нам на почту или позвоните,
                        и мы с радостью поможем вам завершить заказ.
                    </p>
                    <h4>Контакты для связи:</h4>
                    <div class="contacts-info">
                        <a href="">+7 (495) 206 07 02</a>
                        <a href="mailto:info@madecompany.com"
                            >info@madecompany.com</a
                        >
                    </div>
                </div>
            </div>
            <!-- Order Form -->
            <form class="order-form">
                <div class="cart-head">
                    <div>ДАННЫЕ ПОКУПАТЕЛЯ</div>
                </div>
                <input type="text" placeholder="фио" required />
                <input type="text" placeholder="адрес доставки" required />
                <div style="display:flex; gap:10px;">
                    <div style="flex:2">
                        <input
                            type="text"
                            placeholder="+7 (___) ___-__-__"
                            required
                        />
                    </div>
                    <div style="flex:3">
                        <input type="email" placeholder="email" required />
                    </div>
                </div>
                <textarea rows="2" placeholder="комментарий к заказу"
                ></textarea>
                <label
                    >для расчета стоимости и сроков доставки, выберите
                    пожалуйста область</label
                >
                <select>
                    <option value="">Москва и Московская область</option>
                    <option>Санкт-Петербург</option>
                    <option>Другой регион</option>
                </select>

                <label>способ получения товара</label>
                <div class="delivery-methods">
                    <div class="delivery-method">
                        <span>доставка курьером</span>
                        <span>от 290 ₽</span>
                        <span>8 августа</span>
                    </div>
                    <div class="delivery-method">
                        <span>Самовывоз из пукта выдачи</span>
                        <span>бесплатно</span>
                        <span>30 июля</span>
                    </div>
                </div>
                <div class="order-summary">
                    <div class="summary-row">
                        <span>СТОИМОСТЬ ТОВАРОВ:</span>
                        <span>22 150Р</span>
                    </div>
                    <div class="summary-row">
                        <span>СТОИМОСТЬ ДОСТАВКИ:</span>
                        <span>БЕСПЛАТНО</span>
                    </div>
                    <div class="summary-total">22 150Р</div>
                </div>

                <div class="order-bottom">
                    <div class="order-bottom__info">
                        Нажимая на кнопку "Оформить заказ", вы соглашаетесь с
                        <a href="">условиями обработки персональных данных.</a>
                    </div>
                    <button class="btn">
                        <BigButton
                            buttonText="оформить заказ"
                            hrefPage=""
                            classes=""
                        />
                    </button>
                </div>
            </form>
        </div>
    </section>
    <Footer />
</Layout>

<style>
    .header-container {
        display: flex;
        justify-content: space-around;
        align-items: flex-end;
    }
    .header-container__info {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }
    .header-container__info p {
        max-width: 38.125rem;
    }
    .header-container__order {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        font-size: 28px;
        text-transform: uppercase;
    }
    .header-container__order span {
        color: oklch(from var(--grey-text) l c h);
    }

    /* корзина */
    .container {
        max-width: 1751px;
        margin: 0 auto;
        padding: 40px 0;
        display: flex;
        gap: 40px;
    }

    .cart,
    .order-form {
        padding: 4.5rem 2rem;
        flex: 1 1 50%;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        justify-content: space-between;
        max-height: 1449px;
    }

    .cart {
        border-right: 1px solid #353544;
    }

    .cart-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        text-transform: uppercase;
        font-size: 16px;
        color: oklch(from var(--body-text) l c h);
        font-family: "JetBrainsMono";
        .btn {
            text-transform: uppercase;
            padding: 0;
        }
    }

    .cart-product {
        background: #18181f;
        border-radius: 15px;
        display: flex;
        align-items: flex-start;
        padding: 18px 18px 16px 18px;
        box-shadow: 0 2px 8px #0005;
    }
    .cart-product img {
        width: 70px;
        height: auto;
        border-radius: 7px;
        margin-right: 18px;
        background: #333;
        object-fit: contain;
        box-shadow: 0 1px 4px #000c;
    }
    .cart-product-details {
        flex: 1;
    }
    .product-title {
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 1px;
        margin-bottom: 7px;
        color: #f4f7ff;
    }
    .product-row {
        display: flex;
        gap: 40px;
        font-size: 13px;
        opacity: 0.85;
        margin-bottom: 8px;
    }
    .product-price {
        color: #b48aff;
        font-size: 20px;
        font-weight: 700;
        text-align: right;
        margin-top: 10px;
    }
    .product-art {
        font-size: 11px;
        color: #80849a;
        margin-bottom: 4px;
    }
    .cart-product-actions {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-left: 9px;
        margin-top: 8px;
    }
    .quantity {
        width: 36px;
        padding: 4px;
        background: #1a1930;
        border: none;
        border-radius: 5px;
        color: #f4f4f8;
        font-family: inherit;
        text-align: center;
        margin-bottom: 10px;
    }
    .remove-btn {
        background: none;
        border: none;
        color: #ab97d9;
        font-size: 18px;
        cursor: pointer;
        margin-top: 6px;
        transition: color 0.2s;
    }
    .remove-btn:hover {
        color: #f25af2;
    }

    .optionals {
        display: flex;
        flex-direction: column;
        gap: 23px;
        text-transform: uppercase;
        font-size: 20px;
        color: oklch(from var(--text));
        padding-bottom: 1.5rem;
        border-bottom: 1px dashed #323339;
    }
    .optionals label {
        font-size: 12px;
        color: oklch(from var(--body-text));
        font-family: "JetBrainsMono";
    }
    .switch {
        position: relative;
        display: inline-block;
        width: 67px;
        height: 30px;
        vertical-align: middle;
        margin-right: 7px;
    }
    .switch input {
        display: none;
    }
    .slider {
        position: absolute;
        cursor: pointer;
        background-color: #313143;
        border: 1px solid oklch(from var(--body-text));
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        border-radius: 8px;
        transition: 0.4s;
    }
    .slider:before {
        position: absolute;
        content: "";
        height: 24px;
        width: 24px;
        left: 3px;
        bottom: 3px;
        background-color: #d7a6ff;
        border-radius: 50%;
        transition: 0.4s;
    }
    input:checked + .slider {
        background: #280055;
    }
    input:checked + .slider:before {
        left: 40px;
        background: #d7a6ff;
    }
    .additional-text {
        opacity: 0.72;
        margin-left: 13px;
    }
    .contacts-block {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        font-size: 20px;
        font-family: "JetBrainsMono";
        padding: 1.5rem 1rem;
        margin-top: 1.5rem;
        border: 1px solid oklch(from var(--stroke) l c h);
    }
    .contacts-block h4 {
        font-family: "JetBrainsMono";
        text-transform: uppercase;
        font-size: 20px;
    }
    .contacts-block h4:first-child {
        font-family: "EuropeExt";
    }
    .contacts-block p {
        font-size: 16px;
        color: oklch(from var(--grey-text) l c h);
    }
    .contacts-info {
        color: oklch(from var(--text) l c h);
        font-size: 14px;
    }
    .contacts-info {
        display: flex;
        flex-direction: column;
        gap: 14px;
        text-transform: uppercase;
    }

    /* ----------- ORDER FORM ----------- */
    .order-form label {
        font-size: 14px;
        display: block;
        text-transform: uppercase;
        margin: 1rem 0;
    }
    .order-form input,
    .order-form textarea,
    .order-form select {
        width: 100%;
        padding: 29px 24px;
        background: oklch(from var(--card) l c h);
        border: 1px solid oklch(from var(--stroke) l c h);
        color: oklch(from var(--grey-text) l c h);
        outline: none;
        font-size: 14px;
        font-family: "JetBrainsMono";
        text-transform: uppercase;
        resize: vertical;
        transition: border 0.2s;
        border-radius: 0;
    }
    .delivery-methods {
        display: flex;
        gap: 14px;
    }
    .delivery-method {
        display: flex;
        flex-direction: column;
        gap: 24px;
        flex: 1 1;
        padding: 18px;
        border: 1px dashed oklch(from var(--stroke) l c h);
        background: oklch(from var(--card) l c h);
        text-transform: uppercase;
        font-family: "JetBrainsMono";
        text-align: center;
        font-size: 16px;
        cursor: pointer;
        transition:
            border 0.2s,
            background 0.2s;
        user-select: none;
    }
    .delivery-method span:last-child {
        color: oklch(from var(--grey-text) l c h);
    }
    .delivery-method.selected,
    .delivery-method:hover {
        border: 1px solid oklch(from var(--purple) l c h);
    }
    .order-summary {
        margin-top: 35px;
        font-size: 14px;
    }
    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 7px;
    }
    .summary-total {
        font-size: 22px;
        color: #b88aff;
        font-weight: 700;
        letter-spacing: 1px;
        text-align: right;
    }
    .order-bottom{
        display: flex;
        align-items: center;
    }
    .order-bottom__info{
        font-weight: 600;
        font-size: 12px;
        line-height: 120%;
    }
    .order-bottom__info a{
        color: oklch(from var(--purple-text) l c h);
        text-decoration: underline;
    }
    /* ---------- MEDIA ---------- */
    @media (max-width: 1100px) {
        .container {
            flex-direction: column;
            padding: 2vw;
        }
        .cart,
        .order-form {
            border-right: none;
        }
    }
    @media (max-width: 620px) {
        .container {
            padding: 4px;
        }
        .cart,
        .order-form {
            padding: 10px;
        }
    }
</style>
