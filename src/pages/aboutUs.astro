---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import PurpleTag from "../components/PurpleTag.astro";
import StagesOfWork from "../components/StagesOfWork.astro";
import DifferenceCard from "../components/DifferenceCard.astro";
import BigButton from "../components/BigButton.astro";

const stages = [
    {
        number: 1,
        title: "Консультация и брифинг",
        description:
            "На этом этапе мы уточняем, зачем вам компьютер: для игр, работы, монтажа, 3D-графики, стримов или чего‑то ещё. Обсуждаем ваши предпочтения по дизайну корпуса, типу охлаждения, бюджету и желаемым срокам. Чем больше вы расскажете — тем точнее мы подберём решение. Общение может проходить через мессенджеры, почту или звонок — как вам удобнее.",
    },
    {
        number: 2,
        title: "Подбор конфигурации и визуальный макет",
        description:
            "На основе брифинга мы подбираем комплектующие, которые точно справятся с вашими задачами. Всё сбалансировано: без узких мест, без переплаты. При необходимости делаем 3D-макет сборки — вы увидите, как будет выглядеть ваш компьютер, ещё до начала сборки. По желанию — предложим варианты с RGB, водянкой, вертикальной установкой видеокарты и т.д.",
    },
    {
        number: 3,
        title: "Сборка и настройка",
        description:
            "На основе брифинга мы подбираем комплектующие, которые точно справятся с вашими задачами. Всё сбалансировано: без узких мест, без переплаты. При необходимости делаем 3D-макет сборки — вы увидите, как будет выглядеть ваш компьютер, ещё до начала сборки. По желанию — предложим варианты с RGB, водянкой, вертикальной установкой видеокарты и т.д.",
    },
    {
        number: 4,
        title: "Многоуровневое тестирование",
        description:
            "Перед передачей клиенту ПК проходит тестирование на нескольких уровнях: — Проверка температуры процессора и видеокарты в стресс-нагрузке — Стабильность системы при длительной работе — Отсутствие артефактов, синих экранов, зависаний — Тест скорости SSD, оперативной памяти и подключения — Визуальный контроль каждой подсистемы. Все тесты фиксируются — по запросу можем прислать скриншоты или видеоотчёт.",
    },
    {
        number: 5,
        title: "Отправка или самовывоз",
        description:
            "Когда всё готово, мы аккуратно упаковываем системный блок, используя дополнительную защиту внутри корпуса, чтобы ничего не повредилось в дороге. Отправка осуществляется надёжной транспортной компанией с трек-номером. Также возможен самовывоз из мастерской или доставка курьером по городу. Вместе с ПК вы получаете комплект документов, гарантийный талон и рекомендации по дальнейшему использованию.",
    },
];

const myPath = [
    { text: "главное", href: "#" },
    { text: "О компании", href: "#" },
];
---

<Layout>
    <Header />
    <Nav items={myPath} />
    <section class="article-container purple-effect2">
        <div class="article-row">
            <h2>Мы верим, что компьютер должен работать без компромиссов</h2>
            <div>
                <p>
                    Мы знаем, насколько важно, чтобы техника не подводила.
                    Именно поэтому наша сборка — это не только мощные
                    комплектующие, но и внимание к каждой мелочи:
                </p>
                <p>
                    Профессиональное тестирование после сборки;
                    Кабель-менеджмент, на который приятно смотреть; Корректная
                    настройка BIOS и драйверов; Сборка под задачи: игры, работа,
                    монтаж, стрим, 3D.
                </p>
                <p>
                    Вся работа проходит по внутреннему чек-листу качества,
                    а клиент получает не просто «железо в корпусе», а систему,
                    которой можно доверять в работе и на отдыхе.
                </p>
            </div>
        </div>
        <div class="article-row">
            <img
                alt="pc"
                src="src/assets/images/ArticlePC.png"
                width="684px"
                height="665px"
            />
            <h2>Как мы работаем — от заявки до готового ПК</h2>
            <p>
                Сборка компьютера начинается с консультации: мы уточняем цели,
                бюджет, предпочтения по брендам или внешнему виду. Далее —
                проектируем конфигурацию, подтверждаем с клиентом и переходим
                к сборке.
            </p>
        </div>
    </section>
    <section>
        <StagesOfWork stages={stages} startFrom={1} />
    </section>
    <section class="difference">
        <h2>Что отличает нас от других сборщиков</h2>
        <div class="difference-container">
            <DifferenceCard
                number="001"
                title="Честность и прозрачность в комплектующих"
                text="Мы никогда не используем б/у детали без предупреждения и не ставим дешёвые аналоги под видом оригинала. Каждая конфигурация рассчитана на стабильную работу в любых условиях."
            />
            <DifferenceCard
                number="002"
                title="Индивидуальный подход к каждой сборке"
                text="Мы тщательно подбираем компоненты, учитывая ваши задачи и пожелания, чтобы создать оптимальную систему именно для вас."
            />
            <DifferenceCard
                number="003"
                title="Эстетика и эргономика — не пустые слова"
                text="Даже если корпус останется закрытым, мы аккуратно прячем провода, настраиваем подсветку и продумываем эффективный воздушный поток — это не увеличивает цену, но делает вашу систему лучше."
            />
        </div>
    </section>
    <section class="page">
        <header class="hero">
            <div class="subtitle">[преимущества]</div>
            <h3>5 причин выбрать srf</h3>
        </header>

        <div class="timeline">
            <div class="row">
                <div class="content left">
                    <h4>100% прозрачность и документы на комплектующие</h4>
                </div>
                <div class="connector"><span class="dot"></span></div>
                <div class="content right"></div>
            </div>

            <div class="row">
                <div class="content left"></div>
                <div class="connector"><span class="dot"></span></div>
                <div class="content right">
                    <h3>Фото и видео каждой сборки</h3>
                </div>
            </div>

            <div class="row">
                <div class="content left">
                    <h4>Гарантия до 36 месяцев</h4>
                </div>
                <div class="connector"><span class="dot"></span></div>
                <div class="content right"></div>
            </div>

            <div class="row">
                <div class="content left"></div>
                <div class="connector"><span class="dot accent"></span></div>
                <div class="content right">
                    <h4>Поддержка после покупки</h4>
                    <p class="small">
                        Мы не пропадаем после передачи системника. Возникли
                        вопросы по настройке, установке программ или апгрейду?
                        Пишите — мы на связи. Даже спустя месяцы после сборки
                        можно рассчитывать на нашу помощь и консультации.
                    </p>
                </div>
            </div>

            <div class="row">
                <div class="content left">
                    <h4>Возможность доустановки компонентов в будущем</h4>
                </div>
                <div class="connector"><span class="dot"></span></div>
                <div class="content right"></div>
            </div>
        </div>
    </section>
    <section>
        <div class="form">
            <div class="contact-form-container">
                <PurpleTag text="обратная связь" />
                <p>
                    Компания SFR занимается профессиональной сборкой компьютеров
                    любой сложности: от игровых ПК до рабочих станций для
                    дизайнеров и инженеров. Мы работаем напрямую с поставщиками,
                    гарантируя оригинальные комплектующие, качественную сборку и
                    поддержку.
                </p>
            </div>
            <img
                src="/src/assets/images/castom/form-bg.png"
                alt="pc-bg"
                width="1365px"
                height="735px"
                class="form-bg"
            />
            <div class="contact-form-container">
                <form class="contact-form">
                    <h3>
                        Оставьте свои данные и мы свяжемся с вами
                        для дальнейшего оформления заказа
                    </h3>
                    <div class="input-group angles-white">
                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder="Имя"
                            required
                        />
                    </div>
                    <div class="input-group angles-white">
                        <input
                            type="tel"
                            id="phone"
                            name="phone"
                            placeholder="+7(000) 000 00 00"
                            title="Формат: +7(XXX) XXX-XX-XX"
                            required
                            pattern="/^(1\s|1|)?((\(\d{3}\))|\d{3})(\-|\s)?(\d{3})(\-|\s)?(\d{4})$/"
                            minlength="11"
                            maxlength="18"
                        />
                    </div>
                    <div class="input-group angles-white">
                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="Email"
                            required
                        />
                    </div>
                    <div class="input-group angles-white">
                        <input
                            type="text"
                            id="map"
                            name="map"
                            placeholder="адрес доставки"
                            required
                        />
                    </div>
                </form>
                <div class="contacts-bottom">
                    <p>
                        Нажимая на кнопку "отправить", Вы соглашаетесь с <span
                            class="purple"
                        >
                            Политикой конфиденциальности и обработку
                            персональных данных
                        </span>
                    </p>
                    <BigButton
                        buttonText="отправить"
                        hrefPage="#"
                        classes="contact-btn"
                        type={"submit"}
                    />
                </div>
            </div>
        </div>
    </section>
    <Footer />
</Layout>

<style>
    .article-container {
        display: flex;
        justify-content: space-evenly;
    }
    .article-row {
        max-width: 40%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .article-row h2 {
        font-size: 46px;
        max-width: none;
    }
    .article-row p {
        font-size: 16px;
        line-height: 120%;
        font-weight: 600;
        font-family: "JetBrainsMono";
        margin-top: 1rem;
    }
    .article-row img {
        height: auto;
        width: auto;
        padding: 2.875rem 11.25rem;
        margin-bottom: 1rem;
        border: 1px dashed oklch(from var(--light-stroke) l c h);
    }
    .difference {
        max-width: 110rem;
        margin: 5rem auto;
    }
    .difference h2 {
        max-width: 72.25rem;
    }
    .difference-container {
        display: flex;
        justify-content: space-evenly;
    }

    /* причины */
    .page {
        max-width: 1100px;
        margin: 0 auto;
    }

    .hero {
        text-align: center;
        margin-bottom: 40px;
        text-transform: uppercase;
    }
    .subtitle {
        font-family: "JetBrainsMono";
        color: oklch(from var(--white) l c h);
        margin-bottom: 18px;
    }
    .hero h3 {
        font-size: 46px;
    }

    /* ===== Timeline ===== */
    .timeline {
        position: relative;
        padding: 40px 0;
        display: flex;
        flex-direction: column;
        gap: 34px;
    }

    .timeline::before {
        content: "";
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        top: 0;
        bottom: 0;
        width: 2px;
        background: linear-gradient(
            to bottom,
            rgba(255, 255, 255, 0.02),
            rgba(255, 255, 255, 0.03) 30%,
            rgba(255, 255, 255, 0.02)
        );
    }

    /* ===== Rows ===== */
    .row {
        display: grid;
        grid-template-columns: 1fr 80px 1fr;
        align-items: center;
        column-gap: 20px;
    }

    /* Контент */
    .content {
        padding: 0 20px;
        max-width: 420px;
    }
    .content.left {
        text-align: right;
    }
    .content.right {
        text-align: left;
    }

    .content h4 {
        font-family: "JetBrainsMono";
        text-transform: uppercase;
    }

    .small {
        margin-top: 20px;
        font-size: 12px;
        line-height: 1.2;
        font-family: "JetBrainsMono";
    }

    /* ===== Connector ===== */
    .connector {
        position: relative;
        height: 1px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        border: 2px solid oklch(from var(--light-stroke) l c h);
        background: transparent;
        display: block;
        position: relative;
    }

    .dot.accent {
        background: var(--accent);
        border-color: oklch(from var(--purple) l c h);
        box-shadow: 0 0 12px oklch(from var(--purple) l c h);
    }

    /* Линии от точки к сторонам */
    .connector::before,
    .connector::after {
        content: "";
        position: absolute;
        height: 2px;
        top: 50%;
        width: 40px;
        background: linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.05),
            rgba(255, 255, 255, 0.05)
        );
    }

    /* По умолчанию обе стороны выключены */
    .connector::before,
    .connector::after {
        opacity: 0;
    }

    /* Чередование: нечетные — линия влево, четные — вправо */
    .row:nth-child(odd) .connector::before {
        opacity: 1;
        right: 50%;
        transform: translateY(-50%) translateX(-10px);
    }
    .row:nth-child(even) .connector::after {
        opacity: 1;
        left: 50%;
        transform: translateY(-50%) translateX(10px);
    }

    /* ===== Адаптив ===== */
    @media (max-width: 1440px) {
        .difference-container {
            flex-direction: column;
            align-items: center;
        }
    }
    @media (max-width: 800px) {
        .hero h3 {
            font-size: 32px;
            letter-spacing: 3px;
        }

        .timeline::before {
            left: 50%;
            transform: translateX(-50%);
        }

        .row {
            grid-template-columns: 1fr;
            text-align: center;
            gap: 10px;
        }

        .content {
            max-width: unset;
            padding: 0 10px;
        }

        .content.left,
        .content.right {
            text-align: center;
        }

        /* Заголовки над точками */
        .content h3 {
            order: -1;
            margin-bottom: 6px;
        }

        /* Точка */
        .connector {
            justify-content: center;
            order: 0;
        }

        /* Все точки фиолетовые */
        .dot {
            background: oklch(from var(--purple) l c h);
            border-color: oklch(from var(--purple) l c h);
            box-shadow: 0 0 12px oklch(from var(--purple) l c h);
        }

        /* Линии убираем */
        .connector::before,
        .connector::after {
            display: none;
        }

        /* Описание под точкой */
        .small {
            order: 1;
            margin-top: 8px;
        }
    }

    /* form */
    .form {
        background-color: oklch(from var(--bg) l c h);
        background-image: url(/src/assets/icons/main-pattern.svg);
        background-repeat: repeat;
        padding: 3.75rem;
        margin: 0 auto;
        max-height: 50rem;
        min-height: 48.5rem;
        display: flex;
        justify-content: center;
        gap: 2rem;
        position: relative;
    }
    .form img{
        position: absolute;
    }
    .form-bg {
        transform: scale(-1, 1);
        height: auto;
        width: auto;
    }
    .contact-form-container {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: space-between;
        padding: 3.75rem;
        max-width: 40%;
    }
    .contacts-bottom {
        display: flex;
        width: 100%;
        justify-content: space-between;
        align-items: center;
    }
    .contact-form-container svg {
        width: 32px;
        height: 32px;
        fill: #fff;
        transform: rotate(45deg);
        position: absolute;
        top: 2%;
        right: 2%;
    }
    .contact-form-container p{
        max-width: 26rem;
    }
    input:not(.product-catalog input) {
        background-color: oklch(from var(--card) l c h);
        border: 1px solid oklch(from var(--light-stroke) l c h);
        padding: 1.5rem;
        width: 100%;
        text-transform: uppercase;
        font-family: "JetBrainsMono";
    }
    .contact-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        font-family: "JetBrainsMono";
    }
    .contact-form h3 {
        font-size: 28px;
        text-transform: uppercase;
    }
    .contacts-bottom p {
        max-width: 320px;
        font-size: 12px;
        font-weight: 600;
        line-height: 1.2;
    }
    .contact-form p:first-child {
        font-family: "EuropeExt";
        font-size: 28px;
        text-transform: uppercase;
    }

    .purple {
        color: oklch(from var(--purple-text) l c h);
        text-decoration: underline;
    }
</style>
