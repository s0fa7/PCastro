<script>
    // app.ts

    class Carousel {
        private carouselSlider: HTMLElement;
        private carouselItems: NodeListOf<HTMLElement>;
        private prevButton: HTMLButtonElement;
        private nextButton: HTMLButtonElement;
        private currentIndex: number;
        private totalItems: number;

        constructor(containerSelector: string) {
            const container =
                document.querySelector<HTMLElement>(containerSelector);
            if (!container) {
                throw new Error("Carousel container not found");
            }

            this.carouselSlider =
                container.querySelector<HTMLElement>(".carousel-slider")!;
            this.carouselItems =
                container.querySelectorAll<HTMLElement>(".carousel-item");
            this.prevButton = document.querySelector<HTMLButtonElement>(
                ".carousel-navigation .nav-arrow.prev",
            )!; // Изменили селектор, т.к. кнопки теперь вне контейнера карусели
            this.nextButton = document.querySelector<HTMLButtonElement>(
                ".carousel-navigation .nav-arrow.next",
            )!; // Изменили селектор

            this.totalItems = this.carouselItems.length;
            this.currentIndex = 0;

            this.init();
        }

        private init(): void {
            this.updateCarousel();
            this.addEventListeners();
        }

        private addEventListeners(): void {
            this.prevButton.addEventListener("click", () => this.goToPrev());
            this.nextButton.addEventListener("click", () => this.goToNext());
        }

        private goToPrev(): void {
            this.currentIndex =
                (this.currentIndex - 1 + this.totalItems) % this.totalItems;
            this.updateCarousel();
        }

        private goToNext(): void {
            this.currentIndex = (this.currentIndex + 1) % this.totalItems;
            this.updateCarousel();
        }

        private updateCarousel(): void {
            const offsetXStep = parseFloat(
                getComputedStyle(document.documentElement).getPropertyValue(
                    "--offset-x-step",
                ),
            );
            const offsetYStep = parseFloat(
                getComputedStyle(document.documentElement).getPropertyValue(
                    "--offset-y-step",
                ),
            );
            const baseZIndex = parseFloat(
                getComputedStyle(document.documentElement).getPropertyValue(
                    "--base-z-index",
                ),
            );

            this.carouselItems.forEach((item, index) => {
                item.classList.remove("active");

                if (index === this.currentIndex) {
                    // Активный элемент
                    item.classList.add("active");
                    item.style.transform = `translate(0px, 0px)`; // Активный элемент без смещения
                    item.style.zIndex = `${baseZIndex + this.totalItems}`; // Самый высокий z-index
                } else {
                    // Неактивные элементы
                    // Рассчитываем смещение относительно активного элемента
                    // Элементы, идущие после активного, должны быть смещены вправо-вниз и находиться под ним.
                    // Элементы, идущие до активного, должны быть смещены вправо-вниз, но находиться над ними.

                    let offsetIndex;
                    if (index > this.currentIndex) {
                        offsetIndex = index - this.currentIndex; // Если элемент после активного
                    } else {
                        offsetIndex =
                            this.totalItems - this.currentIndex + index; // Если элемент до активного (переходит в конец стопки)
                    }

                    const translateX = offsetIndex * offsetXStep;
                    const translateY = offsetIndex * offsetYStep;

                    item.style.transform = `translate(${translateX}px, ${translateY}px)`;
                    item.style.zIndex = `${baseZIndex - offsetIndex}`; // Чем дальше, тем ниже z-index
                }
            });
        }
    }

    // Инициализация карусели при загрузке DOM
    document.addEventListener("DOMContentLoaded", () => {
        try {
            new Carousel(".carousel-container");
        } catch (error) {
            console.error("Failed to initialize carousel:", error);
        }
    });
</script>

