                            <input type="checkbox" />
                            <span class="checkmark"></span>
                            <span class="checkbox-label">диски ssd<sub>26</sub></span>
                        </label>
                        <label class="checkbox-container">
                            <input type="checkbox" />
                            <span class="checkmark"></span>
                            <span class="checkbox-label">диски hdd<sub>26</sub></span>
                        </label>
                        <label class="checkbox-container">
                            <input type="checkbox" />
                            <span class="checkmark"></span>
                            <span class="checkbox-label">блок питания<sub>26</sub></span>
                        </label>
                        <label class="checkbox-container">
                            <input type="checkbox" />
                            <span class="checkmark"></span>
