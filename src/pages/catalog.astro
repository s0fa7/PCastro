---
import Layout from "../layouts/Layout.astro";
import TheArticle from "../components/TheArticle.astro";
import Footer from "../components/Footer.astro";
import PopularList from "../components/PopularList.astro";
import ProductCard from "../components/ProductCard.astro";
import Header from "../components/Header.astro";
import Nav from "../components/Nav.astro";
import OrderButton from "../components/OrderButton.astro";

import GraphicCard from "../assets/images/products/product-card/graphic-card.png";
import Ram from "../assets/images/products/product-card/ram.png";
import Cross from "../assets/icons/product-card/cross.svg";
import Filtr from "../assets/icons/Filtr.svg";

const myPath = [
    { text: "главное", href: "#" },
    { text: "каталог", href: "#" },
    { text: "процессоры", href: "#" },
];
const PathProducts = [
    { text: "каталог", href: "#" },
    { text: "процессоры", href: "#" },
    { text: "intel", href: "#" },
];

const customArticles = [
    {
        id: 1,
        title: "Как выбрать процессор по задачам",
        body: "Если вы собираете компьютер для повседневной работы или учёбы, обратите внимание на модели с 2–4 ядрами, встроенной графикой и низким энергопотреблением. Для игр и стриминга подойдут решения с 6–12 ядрами и высокой тактовой частотой. Профессионалам, работающим с рендерингом, программированием или 3D-графикой, стоит выбрать процессоры с большим числом потоков и поддержкой многозадачности.",
    },
    {
        id: 2,
        title: "Процессоры Intel и AMD: в чём разница?",
        body: "Intel традиционно славится высокой однопоточной производительностью, что особенно важно для геймеров. Линейки Core i3, i5, i7 и i9 охватывают все категории пользователей. AMD же делает акцент на многопоточности и соотношении цена/производительность — их процессоры Ryzen отлично показывают себя как в повседневных задачах, так и в тяжёлой работе. Кроме того, многие чипы AMD оснащены мощной встроенной графикой Vega.",
    },
    {
        id: 3,
        title: "BOX или OEM: какую комплектацию выбрать?",
        body: "В нашем каталоге вы можете выбрать процессоры в комплектациях BOX и OEM. BOX-процессоры поставляются в фирменной упаковке и включают кулер — идеальный вариант для домашних сборок. OEM-версии дешевле, но предназначены для опытных пользователей, уже имеющих охлаждение и корпус. При выборе учитывайте ваши требования к охлаждению и бюджету.",
    },
    {
        id: 4,
        title: "Совместимость с материнской платой",
        body: "Обратите внимание на сокет процессора — он должен совпадать с разъёмом на материнской плате. В нашем фильтре вы легко можете выбрать совместимые модели по сокету: LGA1200, AM4, AM5 и другие. Если вы не уверены в совместимости, наша служба поддержки поможет подобрать комплектующие.",
    },
];
---

