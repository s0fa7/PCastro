---
import Layout from "../layouts/Layout.astro";
import TheArticle from "../components/TheArticle.astro";
import Footer from "../components/Footer.astro";
import PopularList from "../components/PopularList.astro";
import ProductCard from "../components/ProductCard.astro";
import Header from "../components/Header.astro";
import Nav from "../components/Nav.astro";
import OrderButton from "../components/OrderButton.astro";

import GraphicCard from "../assets/images/products/product-card/graphic-card.png";
import Ram from "../assets/images/products/product-card/ram.png";
import Cross from "../assets/icons/product-card/cross.svg";

const myPath = [
    { text: "главное", href: "#" },
    { text: "каталог", href: "#" },
    { text: "процессоры", href: "#" },
];
const PathProducts = [
    { text: "каталог", href: "#" },
    { text: "процессоры", href: "#" },
    { text: "intel", href: "#" },
];

const customArticles = [
    {
        id: 1,
        title: "Как выбрать процессор по задачам",
        body: "Если вы собираете компьютер для повседневной работы или учёбы, обратите внимание на модели с 2–4 ядрами, встроенной графикой и низким энергопотреблением. Для игр и стриминга подойдут решения с 6–12 ядрами и высокой тактовой частотой. Профессионалам, работающим с рендерингом, программированием или 3D-графикой, стоит выбрать процессоры с большим числом потоков и поддержкой многозадачности.",
    },
    {
        id: 2,
        title: "Процессоры Intel и AMD: в чём разница?",
        body: "Intel традиционно славится высокой однопоточной производительностью, что особенно важно для геймеров. Линейки Core i3, i5, i7 и i9 охватывают все категории пользователей. AMD же делает акцент на многопоточности и соотношении цена/производительность — их процессоры Ryzen отлично показывают себя как в повседневных задачах, так и в тяжёлой работе. Кроме того, многие чипы AMD оснащены мощной встроенной графикой Vega.",
    },
    {
        id: 3,
        title: "BOX или OEM: какую комплектацию выбрать?",
        body: "В нашем каталоге вы можете выбрать процессоры в комплектациях BOX и OEM. BOX-процессоры поставляются в фирменной упаковке и включают кулер — идеальный вариант для домашних сборок. OEM-версии дешевле, но предназначены для опытных пользователей, уже имеющих охлаждение и корпус. При выборе учитывайте ваши требования к охлаждению и бюджету.",
    },
    {
        id: 4,
        title: "Совместимость с материнской платой",
        body: "Обратите внимание на сокет процессора — он должен совпадать с разъёмом на материнской плате. В нашем фильтре вы легко можете выбрать совместимые модели по сокету: LGA1200, AM4, AM5 и другие. Если вы не уверены в совместимости, наша служба поддержки поможет подобрать комплектующие.",
    },
];
---

<Layout>
    <Header />
    <div class="top-container">
        <div class="top-left-container">
            <Nav items={myPath} />
            <div>
                <h2>каталог</h2>
                <p>
                    Мы предлагаем только проверенные комплектующие и устройства,
                    которые обеспечат стабильную работу в любых условиях:
                    от простых офисных задач до сложных вычислений
                    и ресурсоёмких процессов. В каталоге представлены
                    процессоры, накопители, видеокарты и другое оборудование,
                    подходящее как для персональных сборок, так и для крупных
                    IT-проектов. Удобные фильтры помогут подобрать
                    всё необходимое быстро и точно.
                </p>
            </div>
        </div>
        <div class="promo-banner">
            <h3>ваш идеальный пк- в одном клике</h3>
            <p>
                Надежные сборки от SFR: для игр, работы и творчества. Все
                комплектующие оригинальные. Поддержка - всегда на связи.
            </p>
        </div>
    </div>
    <section>
        <div class="product-catalog">
            <div class="filter-container angles">
                <div class="filter-header">
                    <span>фильтр товаров //</span>
                    <button class="reset-btn btn">
                        <span>сбросить</span>
                        <Cross />
                    </button>
                </div>

                <div class="filter-section">
                    <div class="filter-label collapsible">категория</div>
                    <div class="filter-list">
                        <label class="checkbox-container">
                            <input type="checkbox" /><span class="checkmark"
                            ></span>компьютеры<sub>42</sub>
                        </label>
                        <label class="checkbox-container active">
                            <input type="checkbox" checked /><span
                                class="checkmark"></span>процессоры<sub>26</sub>
                        </label>
                        <label class="checkbox-container">
                            <input type="checkbox" /><span class="checkmark"
                            ></span>видеокарты<sub>24</sub>
                        </label>
                        <label class="checkbox-container">
                            <input type="checkbox" /><span class="checkmark"
                            ></span>материнские платы<sub>26</sub>
                        </label>
                        <!-- Добавьте остальные категории по аналогии -->
                    </div>
                </div>

                <div class="filter-section">
                    <div class="filter-label collapsible">цена</div>
                    <div class="filter-price">
                        <input
                            type="number"
                            class="input-min"
                            min="3210"
                            max="132450"
                            value="3210"
                        />
                        <div class="range-block">
                            <input
                                type="range"
                                min="3210"
                                max="132450"
                                step="100"
                                value="3210"
                                class="range"
                                id="range-min"
                            />
                            <input
                                type="range"
                                min="3210"
                                max="132450"
                                step="100"
                                value="132450"
                                class="range"
                                id="range-max"
                            />
                            <div class="range-fill"></div>
                        </div>
                        <input
                            type="number"
                            class="input-max"
                            min="3210"
                            max="132450"
                            value="132450"
                        />
                    </div>
                </div>

                <!-- <div class="slider-container">
                    <div class="slider-value min">0</div>
                    <div class="slider-wrapper">
                        <div class="slider-bar">
                            <div
                                class="slider-fill"
                                [style.left.%]="getLeftFillPercent(minValue)"
                                [style.width.%]="getWidthFillPercent()"
                            >
                            </div>
                        </div>
                        <input
                            type="range"
                            class="custom-range"
                            [min]="min"
                            [max]="max"
                            [(ngModel)]="minValue"
                            (input)="onMinChange()"
                        />
                        <input
                            type="range"
                            class="custom-range"
                            [min]="min"
                            [max]="max"
                            [(ngModel)]="maxValue"
                            (input)="onMaxChange()"
                        />
                    </div>
                    <div class="slider-value max">34567</div>
                </div> -->

                <div class="filter-section">
                    <div class="filter-label collapsible">бренд</div>
                    <div class="filter-list">
                        <label class="checkbox-container">
                            <input type="checkbox" /><span class="checkmark"
                            ></span>amd<sub>12</sub>
                        </label>
                        <label class="checkbox-container active">
                            <input type="checkbox" checked /><span
                                class="checkmark"></span>intel<sub>21</sub>
                        </label>
                    </div>
                </div>

                <div class="filter-section">
                    <div class="filter-label collapsible">сокет</div>
                </div>
                <div class="filter-section">
                    <div class="filter-label collapsible">серия процессора</div>
                </div>
                <div class="filter-section">
                    <div class="filter-label collapsible">модель</div>
                </div>
                <div class="filter-section">
                    <div class="filter-label collapsible">количество ядер</div>
                </div>
                <div class="filter-section">
                    <div class="filter-label collapsible">
                        интегрированное графическое ядро
                    </div>
                </div>
                <div class="filter-section">
                    <div class="filter-label collapsible">тип комплектации</div>
                    <div class="filter-list">
                        <label class="checkbox-container active">
                            <input type="checkbox" checked /><span
                                class="checkmark"></span>box
                        </label>
                        <label class="checkbox-container disabled">
                            <input type="checkbox" disabled /><span
                                class="checkmark"></span>oem
                        </label>
                    </div>
                </div>
            </div>

            <div class="products">
                <div class="products-tittle">
                    <Nav items={PathProducts} />
                    <div class="search-products">
                        <input type="search" placeholder="поиск" />
                    </div>
                    <select name="">
                        <option value="">сначала дешевле</option>
                        <option value="">сначала дороже</option>
                        <option value="">сначала популярнее</option>
                    </select>
                </div>
                <div class="products-container purple-effect1">
                    <ProductCard
                        id="001"
                        photoSrc={GraphicCard}
                        photoAlt="Graphic card"
                        productTitle="Видеокарта"
                        productSpec="16Gb"
                        price="140 000"
                        isHeartVisible={true}
                    >
                        MSI (G5080-16GTC) GeForce RTX 5080 16G GAMING TRIO OC
                    </ProductCard>
                    <ProductCard
                        id="002"
                        photoSrc={Ram}
                        photoAlt="RAM"
                        productTitle="Оперативная память"
                        productSpec="32Gb"
                        price="140 000"
                        isBadgeVisible={false}
                        isHeartVisible={true}
                    >
                        TEAMGROUP T-Force Delta RGB [DDR5, 6000MHz, 2x16GB]
                    </ProductCard>
                    <ProductCard
                        id="003"
                        photoSrc={GraphicCard}
                        photoAlt="Graphic card"
                        productTitle="Видеокарта"
                        productSpec="16Gb"
                        price="140 000"
                        isHeartVisible={true}
                    >
                        MSI (G5080-16GTC) GeForce RTX 5080 16G GAMING TRIO OC
                    </ProductCard>
                    <ProductCard
                        id="004"
                        photoSrc={Ram}
                        photoAlt="RAM"
                        productTitle="Оперативная память"
                        productSpec="32Gb"
                        price="140 000"
                        isBadgeVisible={false}
                        isHeartVisible={true}
                    >
                        TEAMGROUP T-Force Delta RGB [DDR5, 6000MHz, 2x16GB]
                    </ProductCard>
                    <ProductCard
                        id="005"
                        photoSrc={GraphicCard}
                        photoAlt="Graphic card"
                        productTitle="Видеокарта"
                        productSpec="16Gb"
                        price="140 000"
                        isBadgeVisible={false}
                        isHeartVisible={true}
                    >
                        MSI (G5080-16GTC) GeForce RTX 5080 16G GAMING TRIO OC
                    </ProductCard>
                    <ProductCard
                        id="006"
                        photoSrc={Ram}
                        photoAlt="RAM"
                        productTitle="Оперативная память"
                        productSpec="32Gb"
                        price="140 000"
                        isBadgeVisible={false}
                        isHeartVisible={true}
                    >
                        TEAMGROUP T-Force Delta RGB [DDR5, 6000MHz, 2x16GB]
                    </ProductCard>
                    <ProductCard
                        id="007"
                        photoSrc={GraphicCard}
                        photoAlt="Graphic card"
                        productTitle="Видеокарта"
                        productSpec="16Gb"
                        price="140 000"
                        isBadgeVisible={false}
                        isHeartVisible={true}
                    >
                        MSI (G5080-16GTC) GeForce RTX 5080 16G GAMING TRIO OC
                    </ProductCard>
                    <ProductCard
                        id="008"
                        photoSrc={Ram}
                        photoAlt="RAM"
                        productTitle="Оперативная память"
                        productSpec="32Gb"
                        price="140 000"
                        isBadgeVisible={false}
                        isHeartVisible={true}
                    >
                        TEAMGROUP T-Force Delta RGB [DDR5, 6000MHz, 2x16GB]
                    </ProductCard>
                    <ProductCard
                        id="009"
                        photoSrc={Ram}
                        photoAlt="RAM"
                        productTitle="Оперативная память"
                        productSpec="32Gb"
                        price="140 000"
                        isBadgeVisible={false}
                        isHeartVisible={true}
                    >
                        TEAMGROUP T-Force Delta RGB [DDR5, 6000MHz, 2x16GB]
                    </ProductCard>
                </div>
                <OrderButton text="показать все" class="" />
            </div>
        </div>
    </section>
    <section>
        <PopularList />
    </section>
    <section>
        <div class="faq-section purple-effect2">
            <h4>.Intel///AMD</h4>
            <div class="faq-container">
                <h3>вопрос ответ</h3>
                <div class="faq-list">
                    <div class="faq-item" data-id="0">
                        <div class="faq-question">
                            какой выбрать процессор – intel или amd?
                            <span class="arrow"></span>
                        </div>
                        <div class="faq-answer">
                            Оба бренда предлагают отличные процессоры для разных
                            задач. Параметры и цена зависят от целей: для игр
                            часто выбирают Intel, для задач с многозадачностью —
                            AMD.
                        </div>
                    </div>
                    <div class="faq-item" data-id="1">
                        <div class="faq-question">
                            в чем разница между box и oem?
                            <span class="arrow"></span>
                        </div>
                        <div class="faq-answer">
                            <b>BOX</b> — заводская упаковка с кулером и гарантией
                            от Intel/AMD.<br />
                            <b>OEM</b> — без коробки и кулера, ставится в системные
                            сборки, может иметь только магазинную гарантию.
                        </div>
                    </div>
                    <div class="faq-item" data-id="2">
                        <div class="faq-question">
                            сколько ядер нужно для комфортной работы?
                            <span class="arrow"></span>
                        </div>
                        <div class="faq-answer">
                            Для офисных задач достаточно 4 ядер, для игр и
                            работы с графикой — от 6 до 8 ядер и более.
                        </div>
                    </div>
                    <div class="faq-item" data-id="3">
                        <div class="faq-question">
                            У процессора есть встроенная графика?
                            <span class="arrow"></span>
                        </div>
                        <div class="faq-answer">
                            Для офисных задач достаточно 4 ядер, для игр и
                            работы с графикой — от 6 до 8 ядер и более.
                        </div>
                    </div>
                    <div class="faq-item" data-id="4">
                        <div class="faq-question">
                            Что важнее — частота или количество ядер?
                            <span class="arrow"></span>
                        </div>
                        <div class="faq-answer">
                            Для офисных задач достаточно 4 ядер, для игр и
                            работы с графикой — от 6 до 8 ядер и более.
                        </div>
                    </div>
                    <div class="faq-item" data-id="5">
                        <div class="faq-question">
                            Что такое сокет и как выбрать совместимую
                            материнскую плату?
                            <span class="arrow"></span>
                        </div>
                        <div class="faq-answer">
                            Для офисных задач достаточно 4 ядер, для игр и
                            работы с графикой — от 6 до 8 ядер и более.
                        </div>
                    </div>
                    <div class="faq-item" data-id="6">
                        <div class="faq-question">
                            Поддерживает ли процессор разгон и как это влияет на
                            производительность?
                            <span class="arrow"></span>
                        </div>
                        <div class="faq-answer">
                            Для офисных задач достаточно 4 ядер, для игр и
                            работы с графикой — от 6 до 8 ядер и более.
                        </div>
                    </div>
                    <div class="faq-item" data-id="7">
                        <div class="faq-question">
                            Какие процессоры лучше подходят для игр?
                            <span class="arrow"></span>
                        </div>
                        <div class="faq-answer">
                            Для офисных задач достаточно 4 ядер, для игр и
                            работы с графикой — от 6 до 8 ядер и более.
                        </div>
                    </div>
                    <!-- Остальные вопросы и ответы аналогично -->
                </div>
            </div>
        </div>
    </section>
    <section>
        <TheArticle
            mainTitle="Процессоры для любых задач — от офиса до гейминга"
            tagText="о процессорах"
            descriptionText="Современные процессоры — это сердце любого компьютера, от производительных игровых сборок до лёгких офисных систем. В каталоге представлены модели Intel и AMD различных поколений и серий: от базовых Celeron и Athlon до топовых Core i9 и Ryzen 9. Благодаря гибкой системе фильтров вы можете легко подобрать нужный процессор по числу ядер, сокету, встроенной графике и другим характеристикам."
            articles={customArticles}
            showFeatures={true}
        />
    </section>
    <Footer />
</Layout>

<script>
    // вопрос-ответ
    document.addEventListener("DOMContentLoaded", () => {
        const items = document.querySelectorAll<HTMLElement>(".faq-item");
        items.forEach((item) => {
            const question = item.querySelector(".faq-question");
            question?.addEventListener("click", () => {
                item.classList.toggle("open");
            });
        });
    });

    // фильтры
</script>
