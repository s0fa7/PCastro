                        />

                        <div class="slider-wrapper">
                            <div class="slider-track"></div>
                            <input
                                type="range"
                                min="0"
                                max="132450"
                                value="3216"
                                id="min-range"
                            />
                            <input
                                type="range"
                                min="0"
                                max="132450"
                                value="132450"
                                id="max-range"
                            />
                        </div>

                        <input
                            type="number"
                            id="max-input"
                            min="0"
                            max="132450"
                            step="100"
                            value="132450"
                            class="price-input"
                        />
                    </div>
                </div>

                <div class="filter-section">
                    <div class="filter-label collapsible">бренд</div>
                    <div class="filter-list">
                        <label class="checkbox-container">
                            <input type="checkbox" />
                            <span class="checkmark"></span>
                            <span class="checkbox-label">amd<sub>21</sub></span>
                        </label>
                        <label class="checkbox-container">
                            <input type="checkbox" />
                            <span class="checkmark"></span>
