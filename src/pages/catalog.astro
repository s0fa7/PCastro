                <div class="filter-section">
                    <div class="filter-label collapsible">категория</div>
                    <div class="filter-list">
                        <label class="checkbox-container">
                            <input type="checkbox" />
                            <span class="checkmark"></span>
                            <span class="checkbox-label">компьютеры<sub>48</sub></span>
                        </label>
                        <label class="checkbox-container">
                            <input type="checkbox" />
                            <span class="checkmark"></span>
                            <span class="checkbox-label">процессоры<sub>26</sub></span>
                        </label>
                        <label class="checkbox-container">
                            <input type="checkbox" />
                            <span class="checkmark"></span>
                            <span class="checkbox-label">видеокарты<sub>26</sub></span>
                        </label>
                        <label class="checkbox-container">
                            <input type="checkbox" />
                            <span class="checkmark"></span>
                            <span class="checkbox-label">материнские платы<sub>26</sub></span>
