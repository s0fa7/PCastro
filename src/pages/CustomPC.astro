            }
            .header p {
                max-width: 39rem;
            }

            .configurator {
                margin: 0 auto;
                display: flex;
                justify-content: center;
                gap: 28px;
                align-items: start;
            }

            /* LEFT COLUMN */
            .left {
                background: oklch(from var(--card) l c h);
                padding: 30px 21px;
                display: flex;
                flex-direction: column;
                gap: 1.5rem;
            }

            .preview-label {
                font-size: 20px;
                font-family: "JetBrainsMono";
                text-transform: uppercase;
            }

            .preview {
                position: relative;
                overflow: hidden;

                display: flex;
                align-items: center;
                justify-content: center;
            }

            /* PARAMETERS */
            .params {
                background: transparent;
                padding: 12px 6px;
                border-radius: 10px;
                display: flex;
                flex-direction: column;
                gap: 8px;
            }
            .params h3 {
                font-size: 20px;
                font-family: "JetBrainsMono";
                text-transform: uppercase;
            }
            .param-list {
                list-style: none;
                padding: 0;
                margin: 0;
                display: flex;
                flex-direction: column;
                gap: 1.5rem;
                width: 100%;

                font-family: "JetBrainsMono";
                font-size: 14px;
                text-transform: uppercase;
                color: oklch(from var(--grey-text) l c h);
            }
            .param-item {
                display: flex;
                justify-content: space-between;
                align-items: center;
                width: 100%;
            }
            .param-item span:last-child {
                max-width: 60%;
                color: oklch(from var(--body-text) l c h);
                text-align: right;
            }

            /* TOTAL */
            .total-row {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-top: 1rem;

                font-size: 20px;
                text-transform: uppercase;
                color: oklch(from var(--grey-text) l c h);
            }
            .total-row span:last-child {
                font-size: 28px;
                color: oklch(from var(--purple-text) l c h);
            }

            /* ACTIONS */
            .actions {
                display: flex;
                flex-direction: column;
                gap: 12px;
            }
            .main-order {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }
            .icon-btn {
                border: 1px dashed oklch(from var(--light-stroke) l c h);
                padding: 1rem;
                cursor: pointer;
                align-items: center;
            }

            .small-actions {
                display: flex;
                justify-content: space-between;
                gap: 10px;
                align-items: center;
            }
            .small-actions .btn {
                display: inline-flex;
                align-items: center;
                gap: 12px;
                cursor: pointer;

                font-family: "JetBrainsMono";
                text-transform: uppercase;
            }

            /* RIGHT COLUMN */
            .right {
                min-height: 560px;
                display: flex;
                flex-direction: column;
                gap: 2rem;
                min-width: 50rem;
            }
            .right h3 {
                font-size: 20px;
                text-transform: uppercase;
            }
            .components {
                display: flex;
                flex-direction: column;
                gap: 10px;
                /* overflow: auto; */
                padding-right: 6px;
            }
            .comp-card {
                display: flex;
                gap: 2rem;
                align-items: center;
                justify-content: space-between;
            }
            .comp-left {
                display: flex;
                gap: 10px;
                align-items: center;
                padding: 15px 24px;
                width: 100%;
                max-width: 576px;
                background: oklch(from var(--card) l c h);
            }
            .comp-left-title {
                display: flex;
                align-items: center;
                gap: 1rem;
            }
            .comp-left-title h4 {
                font-size: 20px;
                text-transform: uppercase;
                font-family: "JetBrainsMono";
            }
            .comp-left img {
                width: 43px;
                height: 50px;
            }
            .comp-left__category {
                width: 68px;
                height: 68px;
                padding: 8px;
                border: 1px dashed oklch(from var(--light-stroke) l c h);
            }
            .comp-left__products {
                display: flex;
                flex-direction: column;
            }
            .comp-left__product {
                display: flex;
                gap: 1rem;
                align-items: center;
            }
            .comp-left__product-info {
                display: flex;
                flex-direction: column;
                font-size: 14px;
                max-width: 350px;
                text-transform: uppercase;
                font-family: "JetBrainsMono";
            }
            .comp-left__price {
                display: flex;
                flex-direction: column;
            }
            .comp-left__product-info span:last-child {
                color: oklch(from var(--grey-text) l c h);
                font-size: 12px;
            }
            .detail-actions {
                padding: 12px 25px;
                background: oklch(from var(--card) l c h);

                display: flex;
                gap: 1rem;
            }
            .comp-icon {
                width: 44px;
                height: 44px;
                border-radius: 6px;
                background: linear-gradient(180deg, #111, #0b0b0d);
                display: flex;
                align-items: center;
                justify-content: center;
                border: 1px solid rgba(255, 255, 255, 0.03);
            }
            .comp-name {
                font-size: 14px;
            }
            .comp-action {
                display: flex;
                gap: 8px;
                align-items: center;
            }
            .btn-ghost {
                border: 1px dashed oklch(from var(--light-stroke) l c h);
                padding: 1rem;
                cursor: pointer;
            }

            /* icons small */
            .svg {
                width: 18px;
                height: 18px;
                display: inline-block;
            }

            /* pop up */

            .overlay {
                position: fixed;
                inset: 0;
                background: rgba(0, 0, 0, 0.6);
                opacity: 0;
                visibility: hidden;
                transition: opacity 0.3s ease;
                z-index: 10;
            }

            .overlay.active {
                opacity: 1;
                visibility: visible;
            }

            .popup-reset {
                background: oklch(from var(--dark-card) l c h);
                box-shadow: 2px 2px 5px 3px oklch(from var(--purple) l c h);
                padding: 3.75rem;
                margin: 0 auto;
                max-width: 38.125rem;
                display: flex;
                flex-direction: column;
                gap: 2rem;
                position: fixed;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%) scale(0.9);
                opacity: 0;
                transition: all 0.3s ease;
                z-index: 101;
                pointer-events: none;
            }
            .popup-reset.active {
                opacity: 1;
                transform: translate(-50%, -50%) scale(1);
                pointer-events: all;
            }
            .popup-reset h4 {
                color: oklch(from var(--white) l c h);
                text-transform: uppercase;
                font-size: 20px;
            }
            .popup-reset-btns {
                display: flex;
                justify-content: space-between;
            }
            .popup-reset-btns__reset.btn {
                padding: 0;
            }

            .popup-save,
            .popup-error {
                gap: 1.5rem;
                position: relative;
                top: 30%;
                background: oklch(from var(--dark-card) l c h);
                box-shadow: 2px 2px 5px 3px oklch(from var(--purple) l c h);

                padding: 3.75rem 3.75rem 0;
                margin: 0 auto;
                max-width: 45rem;
                display: flex;
                flex-direction: column;
                gap: 2rem;
            }
            .popup-save h4,
            .popup-error h4 {
                color: oklch(from var(--white) l c h);
                text-transform: uppercase;
                font-size: 28px;
                font-family: "EuropeExt";
            }
            .popup-save p {
                color: oklch(from var(--grey-text) l c h);
                text-transform: uppercase;
                font-size: 14px;
            }
            .popup-error p {
                text-transform: uppercase;
                font-size: 16px;
                font-family: "JetBrainsMono";
            }
            .popup-error ul {
                list-style: url("../assets/icons/Hit.svg");
            }
            .popup-error li {
                color: oklch(from var(--grey-text) l c h);
                text-transform: uppercase;
                font-family: "JetBrainsMono";
            }
            .popup-save svg,
            .popup-error svg {
                width: 32px;
                height: 32px;
                fill: #fff;
                transform: rotate(45deg);
                position: absolute;
                top: 1.5rem;
                right: 12px;
            }
            .popup-save div {
                padding: 29px 1rem;
                border: 1px solid oklch(from var(--light-stroke) l c h);
                width: 100%;
            }
            .popup-error__btns {
                display: flex;
                width: 100%;
                justify-content: space-between;
            }

            .popup-form {
                position: relative;
                top: 3%;
                right: 0;
                left: 0;
                background-color: oklch(from var(--bg) l c h);
                background-image: url(/src/assets/icons/main-pattern.svg);
                background-repeat: repeat;
                padding: 3.75rem;
                margin: 0 auto;
                max-height: 50rem;
                min-height: 48.5rem;
                display: flex;
                justify-content: center;
                gap: 2rem;
            }
            .form-bg {
                transform: scale(-1, 1);
                height: auto;
                width: auto;
            }
            .contact-form-container {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                position: absolute;
                max-width: 768px;
                right: 10%;
                top: 3%;
                padding: 3.75rem;
                border: 1px dashed oklch(from var(--light-stroke) l c h);
            }
            .contacts-bottom {
                display: flex;
                width: 100%;
                justify-content: space-between;
                align-items: center;
            }
            .contact-form-container svg {
                width: 32px;
                height: 32px;
                fill: #fff;
                transform: rotate(45deg);
                position: absolute;
                top: 2%;
                right: 2%;
            }
            input:not(.product-catalog input) {
                background-color: oklch(from var(--card) l c h);
                border: 1px solid oklch(from var(--light-stroke) l c h);
                padding: 1.5rem;
                width: 100%;
                text-transform: uppercase;
                font-family: "JetBrainsMono";
            }
            .contact-form {
                display: flex;
                flex-direction: column;
                gap: 1.5rem;
                font-family: "JetBrainsMono";
            }
            .contact-form h3 {
                font-size: 28px;
                text-transform: uppercase;
            }
            .contacts-bottom p {
                max-width: 320px;
                font-size: 12px;
                font-weight: 600;
                line-height: 1.2;
            }
            .contact-form p:first-child {
                font-family: "EuropeExt";
                font-size: 28px;
                text-transform: uppercase;
            }

            .purple {
                color: oklch(from var(--purple-text) l c h);
                text-decoration: underline;
            }

            .popup-choose {
                padding: 1rem 5.25rem;
                background-color: oklch(from var(--bg) l c h);
                position: absolute;
                z-index: 10;
                top: 3%;
                right: 0;
                left: 0;

                max-height: 90vh; /* важно — ограничиваем высоту в пределах окна */
                overflow-y: auto; /* включаем вертикальную прокрутку */
                overscroll-behavior: contain; /* чтобы при скролле не двигалось всё окно */
            }
            .popup-choose-btn__close svg {
                width: 32px;
                height: 32px;
                fill: oklch(from var(--white) l c h);
                transform: rotate(45deg);
            }

            /* Responsive */
            @media (max-width: 1440px) {
                .header h2 {
                    font-size: 36px;
                }
            }
            @media (max-width: 1024px) {
                .configurator {
                    flex-direction: column;
                    align-items: center;
                }
                .right {
                    order: -1;
                    margin-left: 4rem;
                }
                .header {
                    flex-direction: column;
                }
                .header h2 {
                    font-size: 30px;
                }
                .popup-reset {
                    padding: 12px 24px;
                }
                .popup-save {
                    padding: 1.5rem 0.75rem 0;
                }
                .popup-form {
                    flex-direction: column;
                    top: 7%;
                }
                .popup-form img {
                    order: 2;
                    transform: scale(1, 1);
                }
                .popup-form h3 {
                    font-size: 16px;
                }
                .contact-form-container {
                    left: 10%;
                }
                input {
                    font-size: 12px;
                }
                .contacts-bottom p {
                    font-size: 10px;
                }
            }
        </style>
    </section></Layout
>
