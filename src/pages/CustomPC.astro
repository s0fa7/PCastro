<script>
    document.addEventListener("DOMContentLoaded", () => {
        // кнопки/попапы
        const trashBtns = // Множественное число
            document.querySelectorAll<HTMLButtonElement>(".trash-btn"); // Ищем .error-btn
        const popupReset =
            document.querySelector<HTMLDivElement>(".popup-reset");

        const saveBtn = document.querySelector<HTMLButtonElement>(".btn-save");
        const popupSave = document.querySelector<HTMLDivElement>(".popup-save");

        const formBtn = document.querySelector<HTMLButtonElement>(".form-btn");
        const popupForm = document.querySelector<HTMLDivElement>(".popup-form");

        const catalogBtns = // Множественное число
            document.querySelectorAll<HTMLButtonElement>(".catalog-btn");
        const popupChoose =
            document.querySelector<HTMLDivElement>(".popup-choose");

        const errorBtn =
            document.querySelector<HTMLButtonElement>(".error-btn");
        const popupError =
            document.querySelector<HTMLDivElement>(".popup-error");

        // создание/получение глобального overlay (body > .overlay)
        const ensureGlobalOverlay = (): HTMLDivElement => {
            let global =
                document.querySelector<HTMLDivElement>("body > .overlay");
            if (!global) {
                global = document.createElement("div");
                global.classList.add("overlay");
                document.body.appendChild(global);
            }
            return global;
        };

        // WeakSet для отслеживания overlay, на которые уже навешен handler
        const overlaysWithHandler = new WeakSet<Element>();

        // Map для запоминания, что мы переместили (temporarily) popup внутрь глобального overlay:
        const movedPopups = new WeakMap<
            HTMLElement,
            { parent: Node; nextSibling: Node | null }
        >();

        // возвращает overlay для popup: либо ближайший ancestor .overlay, либо глобальный
        const getOverlayFor = (popup: Element): HTMLDivElement => {
            const ownOverlay = popup.closest<HTMLDivElement>(".overlay");
            return ownOverlay || ensureGlobalOverlay();
        };

        // добавляем обработчик клика по overlay (один раз)
        const ensureOverlayHandler = (overlay: HTMLDivElement) => {
            if (overlaysWithHandler.has(overlay)) return;

            overlay.addEventListener("click", (e) => {
                if (e.target === overlay) {
                    const activePopup = overlay.querySelector<HTMLElement>(
                        ".popup-reset.active, .popup-save.active, .popup-form.active, .popup-choose.active",
                    );
                    if (activePopup) closePopup(activePopup);
                }
            });

            overlaysWithHandler.add(overlay);
        };

        const ensurePopupInsideOverlay = (
            popup: HTMLElement,
            overlay: HTMLDivElement,
        ) => {
            const isInside = !!popup.closest(".overlay");
            if (!isInside && overlay.parentElement === document.body) {
                movedPopups.set(popup, {
                    parent: popup.parentNode as Node,
                    nextSibling: popup.nextSibling,
                });
                overlay.appendChild(popup);
            }
        };

        const restorePopupPosition = (popup: HTMLElement) => {
            const record = movedPopups.get(popup);
            if (!record) return;
            const { parent, nextSibling } = record;
            if (nextSibling && (nextSibling as Node).parentNode === parent) {
                parent.insertBefore(popup, nextSibling);
            } else {
                parent.appendChild(popup);
            }
            movedPopups.delete(popup);
        };

        const openPopup = (popup: HTMLElement) => {
            const overlay = getOverlayFor(popup);
            ensurePopupInsideOverlay(popup, overlay);
            overlay.classList.add("active");
            popup.classList.add("active");
            ensureOverlayHandler(overlay);

            const focusable = popup.querySelector<HTMLElement>(
                "button, [href], input, select, textarea, [tabindex]:not([tabindex='-1'])",
            );
            focusable?.focus();
        };

        const closePopup = (popup: HTMLElement) => {
            const overlay = getOverlayFor(popup);
            overlay.classList.remove("active");
            popup.classList.remove("active");
            restorePopupPosition(popup);
        };

        // --- POPUP RESET ---
        // ИСПРАВЛЕНИЕ: Проверяем .length и вешаем обработчики в цикле
        if (trashBtns.length > 0 && popupReset) {
            trashBtns.forEach((btn) => {
                // <--- Цикл
                btn.addEventListener("click", (e) => {
                    e.preventDefault();
                    openPopup(popupReset);
                });
            });

            // Логика кнопки закрытия остается прежней
            const cancelBtn = popupReset.querySelector<HTMLElement>(
                ".order-button, .popup-reset-btns button:last-child",
            );
            cancelBtn?.addEventListener("click", () => closePopup(popupReset));
        }

        // --- POPUP ERROR ---
        if (errorBtn && popupError) {
            errorBtn.addEventListener("click", (e) => {
                e.preventDefault();
                openPopup(popupError);
            });
            const cancelBtn = popupError.querySelector<HTMLElement>(
                ".popup-error__close",
            );
            cancelBtn?.addEventListener("click", () => closePopup(popupError));
        }

        // --- POPUP SAVE ---
        if (saveBtn && popupSave) {
            saveBtn.addEventListener("click", (e) => {
                e.preventDefault();
                openPopup(popupSave);
            });

            const closeBtn =
                popupSave.querySelector<HTMLButtonElement>(
                    ".popup-save__close",
                );
            closeBtn?.addEventListener("click", () => closePopup(popupSave));

            const copyBlock =
                popupSave.querySelector<HTMLDivElement>(".copy-text");
            if (copyBlock) {
                copyBlock.addEventListener("click", async () => {
                    const text = copyBlock.innerText.trim();
                    try {
                        await navigator.clipboard.writeText(text);
                        const original = text;
                        copyBlock.classList.add("copied");
                        copyBlock.innerText = "Скопировано!";
                        setTimeout(() => {
                            copyBlock.innerText = original;
                            copyBlock.classList.remove("copied");
                        }, 1500);
                    } catch (err) {
                        console.error("Ошибка копирования:", err);
                    }
                });
            }
        }

        // --- POPUP FORM ---
        if (formBtn && popupForm) {
            formBtn.addEventListener("click", (e) => {
                e.preventDefault();
                openPopup(popupForm);
            });

            const closeBtn =
                popupForm.querySelector<HTMLButtonElement>(
                    ".popup-form__close",
                );
            closeBtn?.addEventListener("click", () => closePopup(popupForm));

            const cancelBtn = popupForm.querySelector<HTMLButtonElement>(
                ".popup-form__cancel",
            );
            cancelBtn?.addEventListener("click", (e) => {
                e.preventDefault();
                closePopup(popupForm);
            });

            const innerForm = popupForm.querySelector<HTMLFormElement>("form");
            if (innerForm) {
                innerForm.addEventListener("submit", async (e) => {
                    e.preventDefault();
                    const formData = new FormData(innerForm);
                    console.log("Submitting form via AJAX (simulated):");
                    for (const [k, v] of formData.entries()) console.log(k, v);

                    try {
                        const submitBtn =
                            innerForm.querySelector<HTMLButtonElement>(
                                'button[type="submit"]',
                            );
                        submitBtn?.setAttribute("disabled", "true");
                        setTimeout(() => {
                            innerForm.reset();
                            submitBtn?.removeAttribute("disabled");
                            closePopup(popupForm);
                        }, 700);
                    } catch (err) {
                        console.error("Ошибка отправки формы:", err);
                    }
                });
            }
        }

        // --- POPUP CHOOSE ---
        // ИСПРАВЛЕНИЕ: Проверяем .length и вешаем обработчики в цикле
        if (catalogBtns.length > 0 && popupChoose) {
            catalogBtns.forEach((btn) => {
                // <--- Цикл
                btn.addEventListener("click", (e) => {
                    e.preventDefault();
                    openPopup(popupChoose);
                });
            });

            // Логика кнопки закрытия остается прежней
            const closeBtn = popupChoose.querySelector<HTMLButtonElement>(
                ".popup-choose-btn__close",
            );
            closeBtn?.addEventListener("click", () => closePopup(popupChoose));
        }

        // --- ESC ---
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") {
                const activePopups = document.querySelectorAll<HTMLElement>(
                    ".popup-reset.active, .popup-save.active, .popup-form.active, .popup-choose.active",
                );
                activePopups.forEach((p) => closePopup(p));
            }
        });

        // фильтры
        const minRange = document.getElementById(
            "min-range",
        ) as HTMLInputElement;
        const maxRange = document.getElementById(
            "max-range",
        ) as HTMLInputElement;
        const minInput = document.getElementById(
            "min-input",
        ) as HTMLInputElement;
        const maxInput = document.getElementById(
            "max-input",
        ) as HTMLInputElement;
        const track = document.querySelector(".slider-track") as HTMLDivElement;
        const trackBefore = track as HTMLElement;

        const MIN_GAP = 500;

        /**
         * Обновление положения полосатого диапазона (::before)
         */
        function updateTrack(): void {
            const min = parseInt(minRange.value);
            const max = parseInt(maxRange.value);
            const maxLimit = parseInt(minRange.max);

            const leftPercent = (min / maxLimit) * 100;
            const rightPercent = (max / maxLimit) * 100;
            const width = rightPercent - leftPercent;

            // обновляем стили псевдоэлемента через CSS-переменные
            trackBefore.style.setProperty("--range-left", `${leftPercent}%`);
            trackBefore.style.setProperty("--range-width", `${width}%`);

            // анимация через прямой доступ к ::before
            (trackBefore as any).style.setProperty("--left", `${leftPercent}%`);
            (trackBefore as any).style.setProperty("--width", `${width}%`);

            // применяем через inline-стили (CSSOM для ::before нельзя напрямую)
            (
                trackBefore.querySelector("::before") as HTMLElement | null
            )?.style?.setProperty("left", `${leftPercent}%`);
        }

        /**
         * Синхронизация инпутов и ползунков
         */
        function syncValues(fromInput: boolean): void {
            let minVal = fromInput
                ? parseInt(minInput.value)
                : parseInt(minRange.value);
            let maxVal = fromInput
                ? parseInt(maxInput.value)
                : parseInt(maxRange.value);

            if (maxVal - minVal < MIN_GAP) {
                if (fromInput) {
                    if (document.activeElement === minInput) {
                        minVal = maxVal - MIN_GAP;
                        minInput.value = String(minVal);
                    } else {
                        maxVal = minVal + MIN_GAP;
                        maxInput.value = String(maxVal);
                    }
                } else {
                    if (document.activeElement === minRange) {
                        minRange.value = String(maxVal - MIN_GAP);
                    } else {
                        maxRange.value = String(minVal + MIN_GAP);
                    }
                }
            }

            if (fromInput) {
                minRange.value = String(minVal);
                maxRange.value = String(maxVal);
            } else {
                minInput.value = minRange.value;
                maxInput.value = maxRange.value;
            }

            updateBeforeGradient();
        }

        /**
         * Устанавливаем inline-стили для псевдоэлемента через CSS переменные
         */
        function updateBeforeGradient() {
            const min = parseInt(minRange.value);
            const max = parseInt(maxRange.value);
            const maxLimit = parseInt(minRange.max);

            const leftPercent = (min / maxLimit) * 100;
            const rightPercent = (max / maxLimit) * 100;
            const widthPercent = rightPercent - leftPercent;

            (track as HTMLElement).style.setProperty(
                "--before-left",
                `${leftPercent}%`,
            );
            (track as HTMLElement).style.setProperty(
                "--before-width",
                `${widthPercent}%`,
            );

            const styleEl = document.getElementById(
                "dynamic-style",
            ) as HTMLStyleElement | null;
            const css = `
    .slider-track::before {
      left: ${leftPercent}%;
      width: ${widthPercent}%;
    }
  `;
            if (styleEl) styleEl.textContent = css;
            else {
                const style = document.createElement("style");
                style.id = "dynamic-style";
                style.textContent = css;
                document.head.appendChild(style);
            }
        }

        minRange.addEventListener("input", () => syncValues(false));
        maxRange.addEventListener("input", () => syncValues(false));
        minInput.addEventListener("input", () => syncValues(true));
        maxInput.addEventListener("input", () => syncValues(true));

        updateBeforeGradient();
    });

    document.addEventListener("DOMContentLoaded", () => {
        // фильтры адаптации
        const container = document.querySelector(".filter-container");
        if (!container) return;

        const filtrBtn = container.querySelector(
            ".filtr-btn",
        ) as HTMLElement | null;
        const resetBtn = container.querySelector(
            ".reset-btn",
        ) as HTMLElement | null;
        const filterSections = container.querySelectorAll(".filter-section");

        if (!filtrBtn) return;

        let isOpen = false;

        filtrBtn.addEventListener("click", () => {
            isOpen = !isOpen;

            if (isOpen) {
                filterSections.forEach((section) => {
                    (section as HTMLElement).style.display = "flex";
                });

                filtrBtn.innerHTML = `<svg width="24" height="24" viewBox="0 0 24 24">
                <g clip-path="url(#clip0_944_7643)">
                <path d="M4.5664 3.99998L9.74841 8.51035C10.1915 8.89604 10.4427 9.45705 10.4352 10.0445L10.4134 11.752C10.407 12.2495 10.2155 12.7268 9.87607 13.0906L5.35182 17.941" stroke="#B860FF" stroke-width="2"/>
                <path d="M19.543 3.99998L14.361 8.51035C13.9178 8.89604 13.6667 9.45705 13.6742 10.0445L13.696 11.752C13.7023 12.2495 13.8939 12.7268 14.2333 13.0906L18.7575 17.941" stroke="#B860FF" stroke-width="2"/>
                </g>
                <defs>
                <clipPath id="clip0_944_7643">
                <rect width="24" height="24" fill="white"/>
                </clipPath>
                </defs>
                </svg>`;
            } else {
                filterSections.forEach((section) => {
                    (section as HTMLElement).style.display = "none";
                });

                if (resetBtn) (resetBtn as HTMLElement).style.display = "none";

                filtrBtn.innerHTML = `<svg width="15" height="15" viewBox="0 0 15 16">
                <path d="M13.6367 16H10.9092V14.667H13.6367V16ZM10.9092 14.667H9.5459V14H0V12.667H9.5459V12H10.9092V14.667ZM15 14.667H13.6367V12H15V14.667ZM13.6367 12H10.9092V10.667H13.6367V12ZM4.09082 10.667H1.36328V9.33301H4.09082V10.667ZM1.36328 9.33301H0V6.66699H1.36328V9.33301ZM5.4541 9.33301H4.09082V6.66699H5.4541V9.33301ZM15 8.66699H6.81836V7.33301H15V8.66699ZM4.09082 6.66699H1.36328V5.33301H4.09082V6.66699ZM10.2275 5.33301H7.5V4H10.2275V5.33301ZM7.5 4H6.13672V3.33301H0V2H6.13672V1.33301H7.5V4ZM11.5908 4H10.2275V1.33301H11.5908V4ZM15 3.33301H12.9541V2H15V3.33301ZM10.2275 1.33301H7.5V0H10.2275V1.33301Z" fill="#B860FF"/>
                </svg>`;
            }
        });
        //подфильтры
        const sections = document.querySelectorAll(".filter-section");

        sections.forEach((section) => {
            const label = section.querySelector(".filter-label");
            if (!label) return;

            const content = Array.from(section.children).filter(
                (el) => !el.classList.contains("filter-label"),
            ) as HTMLElement[];

            if (content.length > 0) {
                label.addEventListener("click", () => {
                    const isVisible = content[0].style.display !== "none";

                    if (isVisible) {
                        content.forEach((el) => (el.style.display = "none"));
                        section.classList.remove("open");
                    } else {
                        content.forEach((el) => (el.style.display = ""));
                        section.classList.add("open");
                    }
                });
            }
        });
    });
</script>

