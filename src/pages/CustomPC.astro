---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import TheArticle from "../components/TheArticle.astro";
import BigButton from "../components/BigButton.astro";
import ProductCard from "../components/ProductCard.astro";

import Trash from "../assets/icons/trash.svg";
import Printer from "../assets/icons/printer.svg";
import Mail from "../assets/icons/mail.svg";
import Save from "../assets/icons/save.svg";
import Reset from "../assets/icons/reset.svg";
import OrderButton from "../components/OrderButton.astro";
import Cross from "../assets/icons/product-card/cross.svg";
import GraphicCard from "../assets/images/products/product-card/graphic-card.png";
import Ram from "../assets/images/products/product-card/ram.png";
import Filtr from "../assets/icons/Filtr.svg";

const myPath = [
    { text: "главное", href: "#" },
    { text: "конфигуратор пк", href: "#" },
];
const customArticles = [
    {
        id: 1,
        title: "Преимущества использования визуального конфигуратора ПК",
        body: "Наглядная сборка в реальном времени — все выбранные компоненты отображаются на изображении, вы видите, как меняется ваш ПК с каждым шагом. Интеллектуальная фильтрация — показываются только совместимые комплектующие, что исключает ошибки при сборке. Экономия времени и усилий — весь процесс проходит в одном месте, без необходимости открывать десятки вкладок.",
    },
    {
        id: 2,
        title: "",
        body: "Удобный интерфейс и пошаговая навигация — легко двигаться вперёд или возвращаться к предыдущим этапам для корректировок. Результат в цифрах и картинке — вы получите и визуальную модель компьютера, и список характеристик с ценой. Доступность для всех — будь вы новичок или опытный пользователь, сборка станет простой и понятной.",
    },
];
const PathProducts = [
    { text: "каталог", href: "#" },
    { text: "процессоры", href: "#" },
    { text: "intel", href: "#" },
];
