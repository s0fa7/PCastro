---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import TheArticle from "../components/TheArticle.astro";

const myPath = [
    { text: "главное", href: "#" },
    { text: "конфигуратор пк", href: "#" },
];
const customArticles = [
    {
        id: 1,
        title: "Преимущества использования визуального конфигуратора ПК",
        body: "Наглядная сборка в реальном времени — все выбранные компоненты отображаются на изображении, вы видите, как меняется ваш ПК с каждым шагом. Интеллектуальная фильтрация — показываются только совместимые комплектующие, что исключает ошибки при сборке. Экономия времени и усилий — весь процесс проходит в одном месте, без необходимости открывать десятки вкладок.",
    },
    {
        id: 2,
        title: "",
        body: "Удобный интерфейс и пошаговая навигация — легко двигаться вперёд или возвращаться к предыдущим этапам для корректировок. Результат в цифрах и картинке — вы получите и визуальную модель компьютера, и список характеристик с ценой. Доступность для всех — будь вы новичок или опытный пользователь, сборка станет простой и понятной.",
    },
];
---

<Layout>
    <Header />
    <Nav items={myPath} />
    <section>
        <div class="header">
            <h2>Конфигуратор</h2>
            <p>// Создайте собственный компьютер под любые задачи: от офисной работы до мощного гейминга и профессионального рендеринга. В нашем конфигураторе вы можете выбрать корпус, процессор, видеокарту, оперативную память, систему охлаждения, накопители, блок питания и другие компоненты. Удобный визуальный интерфейс сразу показывает, как будет выглядеть ваша сборка. Комбинируйте детали, сравнивайте характеристики и получайте максимум производительности - всё в реальном времени и без лишних усилий.</p>
        </div>
    </section>
    <section>
        <TheArticle
            mainTitle="Онлайн-конфигуратор компьютера с визуальной сборкой — соберите идеальный ПК прямо на сайте"
            tagText="конфигуратор"
            descriptionText="Планируете собрать игровой, офисный или рабочий компьютер? Наш онлайн-конфигуратор позволит вам сделать это легко и наглядно. На первом шаге выберите корпус, затем — процессор, систему охлаждения, материнскую плату, оперативную память, видеокарту и другие комплектующие. Все выбранные элементы отображаются прямо на экране, чтобы вы могли заранее оценить внешний вид и компоновку будущего компьютера. Конфигуратор автоматически проверит совместимость деталей и предложит только подходящие варианты, избавляя вас от необходимости разбираться в технических нюансах."
            articles={customArticles}
            showFeatures={true}
        />
    </section>
    <Footer />
</Layout>

<style>
    .header{
        display: flex;
        width: 90%;
        margin: 0 auto;
        justify-content: space-between;
    }
    .header p{
        max-width: 39rem;
    }
</style>