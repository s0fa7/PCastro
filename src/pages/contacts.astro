---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import TheArticle from "../components/TheArticle.astro";
import PurpleTag from "../components/PurpleTag.astro";
import OrderButton from "../components/OrderButton.astro";
import BigButton from "../components/BigButton.astro";

const myPath = [
    { text: "главное", href: "#" },
    { text: "конфигуратор пк", href: "#" },
];
---

<Layout>
    <Header />
    <Nav items={myPath} />
    <section class="contacts purple-effect1">
        <h2>Контакты</h2>
        <div class="contact-container">
            <!-- <div class="contact-container__info"> -->
            <div class="contact-container__info-elements">
                <div class="contact-container__info-element">
                    <h3>адрес</h3>
                    <span
                        >г. Москва, ул. Сущевский вал, д. 5, стр. 20, оф. U7
                        (3-й этаж)</span
                    >
                </div>
                <div class="contact-container__info-element">
                    <h3>телефон</h3>
                    <span>+7 495 266 07 92</span>
                </div>
                <div class="contact-container__info-element">
                    <h3>email</h3>
                    <span>info@namecompany.com</span>
                </div>
            </div>
            <div class="form-container">
                <form class="contact-form">
                    <p>остались вопросы?</p>
                    <p>
                        Заполните форму и мы свяжемся с вами в течение 15 минут
                    </p>
                    <div class="input-group">
                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder="Имя"
                            required
                        />
                    </div>
                    <div class="input-group">
                        <input
                            type="tel"
                            id="phone"
                            name="phone"
                            placeholder="+7 000 000-00-00"
                            required
                            pattern="\+?7[ -]?\(?\d{3}\)?[ -]?\d{3}[ -]?\d{2}[ -]?\d{2}|8[ -]?\(?\d{3}\)?[ -]?\d{3}[ -]?\d{2}[ -]?\d{2}"
                            title="Введите номер в формате +7 (XXX) XXX-XX-XX"
                            minlength="10"
                        />
                    </div>
                    <div class="input-group">
                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="Email"
                            required
                        />
                    </div>
                </form>
                <div class="contacts-bottom">
                    <p>
                        Нажимая на кнопку "отправить", Вы соглашаетесь с <span
                            class="purple"
                        >
                            Политикой конфиденциальности и обработку
                            персональных данных
                        </span>
                    </p>
                    <BigButton
                        buttonText="отправить"
                        hrefPage=""
                        classes="contact-btn"
                        type={"submit"}
                    />
                </div>
            </div>
            <!-- </div> -->
            <div class="angles-white map">
                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2242.952766632737!2d37.58907627733693!3d55.79405807309959!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x46b549f8fa0542d3%3A0xa2f492a0e6afb13!2z0YPQuy4g0KHRg9GJ0ZHQstGB0LrQuNC5INCS0LDQuywgNSwg0YHRgtGALjIwLCDQnNC-0YHQutCy0LAsIDEyNzAxOA!5e0!3m2!1sru!2sru!4v1759511264334!5m2!1sru!2sru"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
        </div>
    </section>
    <Footer />
</Layout>
<style>
    .contacts h2 {
        padding: 0.5rem;
    }
    .contacts {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-width: 1753px;
        margin: 0 auto;
    }
    .contact-container {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
    }
    .contact-container__info-elements {
        grid-area: 1 / 1 / 2 / 2;
        padding: 1rem;
        display: flex;
        flex-wrap: wrap;
        max-width: 100%;
    }
    .form-container {
        grid-area: 2 / 1 / 3 / 2;
        padding: 1rem;
    }
    .contact-container__info-element {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-width: 262px;
        margin: 0.5rem;

        font-size: 16px;
        font-family: "JetBrainsMono";
        font-weight: 600;
    }
    .contact-container__info-element h3 {
        color: oklch(from var(--grey-text) l c h);
        text-transform: uppercase;
        font-size: 24px;
        font-weight: 400;
        font-family: "JetBrainsMono";
    }
    .contacts-bottom {
        display: flex;
        width: 100%;
        justify-content: space-between;
        align-items: center;
    }
    input {
        background-color: oklch(from var(--card) l c h);
        border: 1px solid oklch(from var(--light-stroke) l c h);
        padding: 1.5rem;
        width: 100%;
        text-transform: uppercase;
        font-family: "JetBrainsMono";
    }
    .contact-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        font-family: "JetBrainsMono";
    }
    .contacts-bottom p {
        max-width: 320px;
        font-size: 12px;
        font-weight: 600;
        line-height: 1.2;
    }
    .contact-form p:first-child {
        font-family: "EuropeExt";
        font-size: 28px;
        text-transform: uppercase;
    }

    .purple {
        color: oklch(from var(--purple-text) l c h);
        text-decoration: underline;
    }
    .contact-btn {
        justify-content: center;
        padding: 2.4rem;
    }
    .contacts .map {
        height: auto;
        max-width: 622.5rem;
        padding: 1.375rem 1.5rem;
        margin: 0.5rem;
        border: solid 1px oklch(from var(--stroke) l c h);
        grid-area: 1 / 2 / 3 / 3;
    }
    .map iframe {
        width: 100%;
        height: 100%;
    }
    .map.angles-white::before {
        z-index: 1;
    }
    /* error input */
    input:invalid:not(:placeholder-shown) {
        border-color: #b30000;
    }

    input:valid:not(:placeholder-shown) {
        border-color: #b860ff;
    }

    input:invalid:not(:placeholder-shown):focus {
        /* На некоторых браузерах при фокусе может появиться нативное сообщение из title */
    }
    @media (max-width: 1024px) {
        .contact-container {
            grid-template-columns: repeat(1, 1fr);
        }
        .contacts .map {
            grid-area: 2 / 1 / 3 / 2;
            min-height: 300px;
        }
        .form-container {
            grid-area: 3 / 1 / 4 / 2;
        }
        .contact-container__info-elements h3 {
            font-size: 18px;
        }
        .contact-container__info-elements span {
            font-size: 14px;
        }
        .contact-container__info-elements {
            flex-direction: column;
            padding: 0;
        }
        .contacts h2 {
            font-size: 30px;
            margin: 1rem 0.5rem 0;
        }
        .contact-form p {
            font-size: 14px;
        }
        .contact-form p:first-child {
            font-size: 16px;
        }
        input {
            font-size: 12px;
            padding: 1rem 1.125rem;
        }
        .contacts-bottom p {
            font-size: 10px;
        }
        .contact-btn {
            padding: 1rem;
        }
    }
</style>
