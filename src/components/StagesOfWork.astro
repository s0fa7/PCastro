---
interface Stage {
    number: number;
    title: string;
    description: string;
}

export interface Props {
    stages: Stage[];
    startFrom?: number; // можно задать начальный номер этапа (по умолчанию 1)
}

const { stages, startFrom = 1 } = Astro.props;
---

<section class="stages">
    <ol start={startFrom} class="stages__list">
        <h2>Этапы работы</h2>
        {
            stages.map((stage) => (
                <li class="stages__item angles-white">
                    <div class="stages__number">
                        00{stage.number ?? startFrom + stages.indexOf(stage)}
                    </div>
                    <h3>{stage.title}</h3>
                    <p>{stage.description}</p>
                </li>
            ))
        }
    </ol>
</section>

<style>
    .stages__list {
        list-style: none;
        counter-reset: stage;
        display: flex;
        flex-direction: column;
        max-width: 110rem;
        padding: 2rem;
        margin: 0 auto;
    }

    .stages__list h2 {
        max-width: none;
    }

    .stages__item {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        align-items: center;
        justify-items: start;
        padding: 1.5rem;
        font-family: "JetBrainsMono";
        border-top: 1px dashed oklch(from var(--light-stroke) l c h);
    }
    .angles-white::before {
        background:
            conic-gradient(
                    from 90deg at top var(--b) left var(--b),
                    var(--_g) 0
                )
                0 0 / var(--_p),
            conic-gradient(
                    from 180deg at top var(--b) right var(--b),
                    var(--_g)
                )
                100% 0 / var(--_p);
        z-index: 2;
    }
    .stages__item:last-child:last-child.angles-white::before {
        background:
            conic-gradient(
                    from 90deg at top var(--b) left var(--b),
                    var(--_g) 0
                )
                0 0 / var(--_p),
            conic-gradient(
                    from 180deg at top var(--b) right var(--b),
                    var(--_g)
                )
                100% 0 / var(--_p),
            conic-gradient(
                    from 0deg at bottom var(--b) left var(--b),
                    var(--_g)
                )
                0 100% / var(--_p),
            conic-gradient(
                    from -90deg at bottom var(--b) right var(--b),
                    var(--_g)
                )
                100% 100% / var(--_p);
    }
    .stages__item:last-child:last-child {
        border-bottom: 1px dashed oklch(from var(--light-stroke) l c h);
    }

    .stages__number {
        grid-area: 1 / 1 / 2 / 2;
        color: oklch(from var(--grey-text) l c h);
        text-align: center;
    }

    .stages__item h3 {
        font-size: 20px;
        font-family: "EuropeExt";
        text-transform: uppercase;
        margin: 0;
        grid-area: 1 / 2 / 2 / 3;
    }

    .stages__item p {
        margin-top: 0.3rem;
        grid-area: 1 / 3 / 2 / 4;
        line-height: 120%;
        font-weight: 600;
    }
</style>
