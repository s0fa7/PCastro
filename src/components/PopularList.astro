<style>
    .carousel-container {
        max-width: 1536px;
        margin-inline: auto;
        padding-inline: 1rem;
    }

    .popular-list {
        display: none;

        grid-template-columns: repeat(4, minmax(0, 1fr));
        justify-items: center;
        gap: 1.5rem;
    }

    .popular-list.active {
        display: grid;
    }

    @media (width < 768px) {
        .popular-list {
            grid-template-columns: 1fr;
        }
    }
    @media (width >= 768px) {
        .popular-list {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
    @media (width >= 1240px) {
        .popular-list {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }
    @media (width >= 1440px) {
        .popular-list {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    .carousel-pagination {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 1rem;
        padding: 0 10px;
        font-family: monospace;
    }
    .pagination-info {
        display: flex;
        align-items: center;
        gap: 15px;
        text-transform: uppercase;
        font-family: "JetBrainsMono";
        color: oklch(from var(--light-stroke) l c h);
    }
    #currentSlideId {
        color: oklch(from var(--body-text) l c h);
    }
    .progress-bar-container {
        width: 150px;
        height: 16px;
        background: #00000000;
        border-radius: 2px;
        border: 1px solid oklch(from var(--body-text) l c h);
        overflow: hidden;
    }
    .progress-bar-fill {
        height: 100%;
        width: 25%;
        background: repeating-linear-gradient(
            120deg,
            #b99be500 0 8px,
            #9250b4 0 12px
        );
        transition: width 0.3s ease-in-out;
    }
    .pagination-controls {
        display: flex;
        gap: 5px;
    }
    .control-btn {
        background: none;
        border: none;
        color: oklch(from var(--body-text) l c h);
        font-size: 1.5rem;
        cursor: pointer;
        padding: 0 10px;
        transition: opacity 0.3s;
        opacity: 0.8;
    }
    .control-btn:hover:not(:disabled) {
        opacity: 1;
    }
    .control-btn:disabled {
        color: oklch(from var(--light-stroke) l c h);
        cursor: not-allowed;
        opacity: 0.5;
    }
</style>
<script>
    // (carousel.ts) - С логированием и использованием классов для кнопок

    document.addEventListener("DOMContentLoaded", () => {
        console.log(
            "CAROUSEL: Script loaded. Starting initialization for all tab-panes.",
        );

        const stateMap = new WeakMap<HTMLElement, { currentPage: number }>();

        document
            .querySelectorAll(".tab-pane")
            .forEach((rootElement, rootIndex) => {
                const paneId = rootElement.id || `pane-${rootIndex}`;
                console.log(
                    `CAROUSEL: Initializing mechanisms for tab-pane ID: #${paneId}`,
                );

                // Инициализация состояния для этой карусели
                stateMap.set(rootElement as HTMLElement, { currentPage: 1 });

                // --- Ищем элементы по КЛАССУ, чтобы избежать конфликта ID ---
                const listElements = rootElement.querySelectorAll(
                    ".popular-list",
                ) as NodeListOf<HTMLElement>;

                // ! ИСПРАВЛЕНИЕ: Ищем кнопки по классу
                const prevBtn = rootElement.querySelector(
                    ".prev-btn",
                ) as HTMLButtonElement | null;
                const nextBtn = rootElement.querySelector(
                    ".next-btn",
                ) as HTMLButtonElement | null;

                // Остальные элементы, если они уникальны внутри tab-pane, могут остаться по ID
                const progressFill = rootElement.querySelector(
                    "#progressBarFill",
                ) as HTMLElement | null;
                const currentSlideDisplay = rootElement.querySelector(
                    "#currentSlideId",
                ) as HTMLElement | null;
                const totalSlidesDisplay = rootElement.querySelector(
                    "#totalSlidesCount",
                ) as HTMLElement | null;

                if (
                    !listElements.length ||
                    !prevBtn ||
                    !nextBtn ||
                    !progressFill ||
                    !currentSlideDisplay ||
                    !totalSlidesDisplay
                ) {
                    console.warn(
                        `CAROUSEL: Skipping #${paneId} due to missing required controls (Buttons found: ${!!prevBtn && !!nextBtn}).`,
                    );
                    return; // Пропускаем инициализацию, если кнопки не найдены
                }

                const totalPages = listElements.length;
                totalSlidesDisplay.textContent = String(totalPages).padStart(
                    3,
                    "0",
                );

                /** Обновляет состояние и внешний вид карусели. */
                const updateCarouselState = (): void => {
                    const state = stateMap.get(rootElement as HTMLElement)!;
                    const currentPage = state.currentPage;

                    console.log(
                        `CAROUSEL #${paneId}: Updating state to page ${currentPage}/${totalPages}`,
                    );

                    // 1. Обновление Видимости Контейнеров
                    listElements.forEach((list, index) => {
                        const isActive = index + 1 === currentPage;
                        if (isActive) {
                            list.classList.add("active");
                        } else {
                            list.classList.remove("active");
                        }
                    });

                    // 2. Обновление Кнопок
                    prevBtn.disabled = currentPage === 1;
                    nextBtn.disabled = currentPage === totalPages;

                    // 3. Обновление Пагинации
                    const progressPercentage = (currentPage / totalPages) * 100;
                    progressFill.style.width = `${progressPercentage}%`;
                    currentSlideDisplay.textContent = String(
                        currentPage,
                    ).padStart(3, "0");
                };

                // --- Установка обработчиков на кнопки ---
                prevBtn.addEventListener("click", () => {
                    const state = stateMap.get(rootElement as HTMLElement)!;
                    if (state.currentPage > 1) {
                        state.currentPage--;
                        console.log(
                            `CAROUSEL #${paneId}: Prev clicked. New page: ${state.currentPage}`,
                        );
                        updateCarouselState();
                    } else {
                        console.log(
                            `CAROUSEL #${paneId}: Prev clicked. Already on first page.`,
                        );
                    }
                });

                nextBtn.addEventListener("click", () => {
                    const state = stateMap.get(rootElement as HTMLElement)!;
                    if (state.currentPage < totalPages) {
                        state.currentPage++;
                        console.log(
                            `CAROUSEL #${paneId}: Next clicked. New page: ${state.currentPage}`,
                        );
                        updateCarouselState();
                    } else {
                        console.log(
                            `CAROUSEL #${paneId}: Next clicked. Already on last page.`,
                        );
                    }
                });

                // --- Добавление MutationObserver ---
                const observer = new MutationObserver((mutationsList) => {
                    for (const mutation of mutationsList) {
                        if (
                            mutation.type === "attributes" &&
                            mutation.attributeName === "class"
                        ) {
                            if (rootElement.classList.contains("active")) {
                                // Таб только что активирован
                                const state = stateMap.get(
                                    rootElement as HTMLElement,
                                )!;
                                state.currentPage = 1; // Сбрасываем на первую страницу при переключении
                                console.log(
                                    `CAROUSEL #${paneId}: MutationObserver triggered: Tab activated! Resetting to page 1.`,
                                );
                                updateCarouselState();
                            }
                        }
                    }
                });

                observer.observe(rootElement, { attributes: true });

                // Инициализация активной карусели при загрузке
                if (rootElement.classList.contains("active")) {
                    updateCarouselState();
                }
            }); // Конец forEach
    });
</script>
