<style>
    .carousel-container {
        max-width: 1536px;
        margin-inline: auto;
        padding-inline: 1rem;
    }

    .popular-list {
        display: none;

        grid-template-columns: repeat(4, minmax(0, 1fr));
        justify-items: center;
        gap: 1.5rem;
    }

    .popular-list.active {
        display: grid;
    }

    @media (width < 768px) {
        .popular-list {
            grid-template-columns: 1fr;
        }
    }
    @media (width >= 768px) {
        .popular-list {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
    @media (width >= 1240px) {
        .popular-list {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }
    @media (width >= 1440px) {
        .popular-list {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    .carousel-pagination {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 1rem;
        padding: 1.5rem 2rem;
        border: 1px solid oklch(from var(--stroke)l c h);
        border-bottom: none;
    }
    .carousel-pagination.corner-stars-container::before {
        bottom: -5px;
        left: -5px;
        top: auto;
    }
    .carousel-pagination.corner-stars-container::after {
        bottom: -5px;
        right: -5px;
        top: auto;
    }
    .pagination-info {
        display: flex;
        align-items: center;
        gap: 15px;
        text-transform: uppercase;
        font-family: "JetBrainsMono";
        color: oklch(from var(--light-stroke) l c h);
    }
    #currentSlideId {
        color: oklch(from var(--body-text) l c h);
    }
    .progress-bar-container {
        width: 150px;
        height: 16px;
        background: #00000000;
        border-radius: 2px;
        border: 1px solid oklch(from var(--body-text) l c h);
        overflow: hidden;
    }
    .progress-bar-fill {
        height: 100%;
        width: 25%;
        background: repeating-linear-gradient(
            120deg,
            #b99be500 0 8px,
            #9250b4 0 12px
        );
        transition: width 0.3s ease-in-out;
    }
    .pagination-controls {
        display: flex;
        gap: 5px;
    }
    .control-btn {
        background: none;
        border: none;
        color: oklch(from var(--body-text) l c h);
        font-size: 1.5rem;
        cursor: pointer;
        padding: 0 10px;
        transition: opacity 0.3s;
        opacity: 0.8;
    }
    .control-btn:hover:not(:disabled) {
        opacity: 1;
    }
    .control-btn:disabled {
        color: oklch(from var(--light-stroke) l c h);
        cursor: not-allowed;
        opacity: 0.5;
    }
    @media (max-width: 375px) {
        .popular-list.active {
            justify-items: start;
        }
        .carousel-pagination {
            flex-direction: column;
            padding: 0.7rem 2rem;
        }
    }
</style>
<script>
    // (carousel.ts) - С логированием и поддержкой одиночных каруселей

    document.addEventListener("DOMContentLoaded", () => {
        console.log("CAROUSEL: Script loaded.");

        const stateMap = new WeakMap<HTMLElement, { currentPage: number }>();

        const allCarouselRoots = document.querySelectorAll(
            ".tab-pane, .card-list-conntainer",
        );

        console.log(
            `CAROUSEL: Found ${allCarouselRoots.length} potential carousel roots.`,
        );

        allCarouselRoots.forEach((rootElement, rootIndex) => {
            const paneId =
                rootElement.id ||
                rootElement.className.split(" ")[0] ||
                `root-${rootIndex}`;
            const isTabPane = rootElement.classList.contains("tab-pane");

            stateMap.set(rootElement as HTMLElement, { currentPage: 1 });

            const listElements = rootElement.querySelectorAll(
                ".popular-list",
            ) as NodeListOf<HTMLElement>;
            const prevBtn = rootElement.querySelector(
                ".prev-btn",
            ) as HTMLButtonElement | null;
            const nextBtn = rootElement.querySelector(
                ".next-btn",
            ) as HTMLButtonElement | null;
            const progressFill = rootElement.querySelector(
                "#progressBarFill",
            ) as HTMLElement | null;
            const currentSlideDisplay = rootElement.querySelector(
                "#currentSlideId",
            ) as HTMLElement | null;
            const totalSlidesDisplay = rootElement.querySelector(
                "#totalSlidesCount",
            ) as HTMLElement | null;

            if (
                !listElements.length ||
                !prevBtn ||
                !nextBtn ||
                !progressFill ||
                !currentSlideDisplay ||
                !totalSlidesDisplay
            ) {
                console.warn(
                    `CAROUSEL: Skipping .${paneId} (Missing required controls).`,
                );
                return;
            }

            const totalPages = listElements.length;
            totalSlidesDisplay.textContent = String(totalPages).padStart(
                3,
                "0",
            );

            const updateCarouselState = (): void => {
                const state = stateMap.get(rootElement as HTMLElement)!;
                const currentPage = state.currentPage;

                listElements.forEach((list, index) => {
                    const isActive = index + 1 === currentPage;
                    list.classList.toggle("active", isActive);
                });

                prevBtn.disabled = currentPage === 1;
                nextBtn.disabled = currentPage === totalPages;

                const progressPercentage = (currentPage / totalPages) * 100;
                progressFill.style.width = `${progressPercentage}%`;
                currentSlideDisplay.textContent = String(currentPage).padStart(
                    3,
                    "0",
                );
            };

            prevBtn.addEventListener("click", () => {
                const state = stateMap.get(rootElement as HTMLElement)!;
                if (state.currentPage > 1) {
                    state.currentPage--;
                    updateCarouselState();
                }
            });

            nextBtn.addEventListener("click", () => {
                const state = stateMap.get(rootElement as HTMLElement)!;
                if (state.currentPage < totalPages) {
                    state.currentPage++;
                    updateCarouselState();
                }
            });

            if (isTabPane) {
                const observer = new MutationObserver((mutationsList) => {
                    for (const mutation of mutationsList) {
                        if (
                            mutation.type === "attributes" &&
                            mutation.attributeName === "class"
                        ) {
                            if (rootElement.classList.contains("active")) {
                                const state = stateMap.get(
                                    rootElement as HTMLElement,
                                )!;
                                state.currentPage = 1;
                                updateCarouselState();
                            }
                        }
                    }
                });
                observer.observe(rootElement, { attributes: true });

                if (rootElement.classList.contains("active")) {
                    console.log(
                        `CAROUSEL .${paneId}: Tab is already active. Initializing.`,
                    );
                    updateCarouselState();
                }
            } else {
                console.log(
                    `CAROUSEL .${paneId}: Is a Standalone carousel. Initializing immediately.`,
                );
                updateCarouselState();
            }
        });
    });
</script>
