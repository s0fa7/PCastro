---
// Props для динамического наполнения
const {
    title = "МАТЕРИНСКИЕ ПЛАТЫ",
    count = 26,
    image = "/images/motherboard.jpg",
    onClick = null,
} = Astro.props;
---

<div class="card" onclick={onClick}>
    <img src={image} alt="Материнская плата" />
    <div>
        <div class="card-title">{title}<sub>{count}</sub></div>
        <div class="card-arrow">&gt;&gt;</div>
    </div>
</div>

<style>
    .card {
        background: oklch(from var(--card)l c h);
        border: 1px solid oklch(from var(--stroke)l c h);
        clip-path: polygon(100% 0, 100% 70%, 85% 75%, 85% 86%, 100% 90%, 100% 100%, 0 100%, 0 0);

        position: relative;
        cursor: pointer;
        padding: 24px;
        width: 320px;
        height: auto;

        display: flex;
        flex-direction: column;
        justify-content: space-between;

        font-family: "JetBrainsMono";
        text-transform: uppercase;
    }
    .card img {
        width: 180px;
        height: auto;
        margin: 0 auto 28px auto;
        display: block;
    }
    .card-title {
        font-size: 18px;
        letter-spacing: 2%;
        color: oklch(from var(--white)l c h);
    }
    sub {
        font-size: 14px;
        color: oklch(from var(--light-stroke)l c h);
        margin: 4px;
    }
    .card-arrow {
        position: absolute;
        right: 20px;
        bottom: 26px;
        background: rgba(50, 52, 59, 0);
        border-radius: 6px;
        padding: 9px 13px;
        font-size: 1.4rem;
        color: #ededed;
        transition: background 0.15s;
    }
    .card:hover .card-arrow {
        background: #5b5d6b;
    }
</style>
