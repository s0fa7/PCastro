                    <h4 class="category-title">Intel Arc (Новичок на рынке)</h4>
                    <div class="category-group">
                        <ul>
                            <li>Arc A770</li>
                            <li>Arc A750</li>
                            <li>Arc A580</li>
                            <li>Arc A380</li>
                        </ul>
                    </div>
                </div>
            </div>
            <!-- процессоры -->
            <div
                class="columns"
                data-category=".процессоры"
                style="display: none;"
            >
                <div class="column">
                    <h4 class="category-title highlight">Intel</h4>
                    <ul>
                        <li>Core i9</li>
                        <li>Core i7</li>
                        <li>Core i5</li>
                    </ul>
                </div>
                <div class="column">
                    <h4 class="category-title">AMD</h4>
                    <ul>
                        <li>Ryzen 9</li>
                        <li>Ryzen 7</li>
                        <li>Ryzen 5</li>
                    </ul>
                </div>
            </div>

            <!-- материнские платы -->
            <div
                class="columns"
                data-category=".материнские платы"
                style="display: none;"
            >
                <div class="column">
                    <h4 class="category-title highlight">Intel</h4>
                    <ul>
                        <li>Z790 / B760 / H610</li>
                    </ul>
                </div>
                <div class="column">
                    <h4 class="category-title">AMD</h4>
                    <ul>
                        <li>X670 / B650 / A620</li>
                    </ul>
                </div>
            </div>

            <!-- компьютеры -->
            <div
                class="columns"
                data-category=".компьютеры"
                style="display: none;"
            >
                <div class="column">
                    <h4 class="category-title highlight">Игровые ПК</h4>
                    <ul>
                        <li>Бюджетные</li>
                        <li>Средний сегмент</li>
                        <li>Премиум</li>
                    </ul>
                </div>
            </div>

            <!-- оперативная память -->
            <div
                class="columns"
                data-category=".оперативная память"
                style="display: none;"
            >
                <div class="column">
                    <h4 class="category-title highlight">DDR5</h4>
                    <ul>
                        <li>5200 MHz</li>
                        <li>6000 MHz</li>
                    </ul>
                    <h4 class="category-title">DDR4</h4>
                    <ul>
                        <li>3200 MHz</li>
                        <li>3600 MHz</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    //информация появление

    document.addEventListener("click", toggleDropdown);

    function toggleDropdown(e: MouseEvent): void {
        toggle(e, ".info-catalog", ".info-menu");
    }

    function toggle(
        e: MouseEvent,
        watchedElementClass: string,
        toggledElementClass: string,
    ): void {
        const watchedElement = document.querySelector(watchedElementClass);
        const toggledElement = document.querySelector(toggledElementClass);

        console.log(watchedElement);

        if (toggledElement !== null) {
            if (
                watchedElement?.contains(e.target as Node) &&
                toggledElement.hasAttribute("style")
            ) {
                toggledElement.removeAttribute("style");
            } else {
                toggledElement.setAttribute("style", "display: none;");
            }
        }
    }

    //категории появление

    const infoMenuModal = document.querySelector(".modal-overlay");

    document.querySelector(".cataloge")?.addEventListener("click", showMenu);

    function showMenu() {
        if (infoMenuModal !== null && infoMenuModal.hasAttribute("style")) {
            infoMenuModal.removeAttribute("style");
        } else {
            infoMenuModal?.setAttribute("style", "display: none;");
        }
    }

    //категории смена

    document.addEventListener("DOMContentLoaded", () => {
        const sidebarItems =
            document.querySelectorAll<HTMLLIElement>(".sidebar ul li");
        const allColumns = document.querySelectorAll<HTMLDivElement>(
            ".modal-content .columns",
        );

        sidebarItems.forEach((item) => {
            item.addEventListener("click", () => {
                sidebarItems.forEach((li) => li.classList.remove("active"));
                item.classList.add("active");

                const categoryName = item
                    .querySelector("span:last-child")
                    ?.textContent?.trim();
                if (!categoryName) return;

                allColumns.forEach((col) => {
                    if (col.dataset.category === categoryName) {
                        col.style.display = "flex";
                    } else {
                        col.style.display = "none";
                    }
                });
            });
        });
    });
</script>

<style>
    .header-container {
        width: 100%;

        font-family: "JetBrainsMono", sans-serif;
        font-size: 16px;
        text-transform: uppercase;
    }

    .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        max-width: 107.25rem;
        margin: 0 auto;
        padding: 22px 0;
    }

    .header-nav {
        max-width: 1305px;
        width: 70%;
        display: flex;
        flex-direction: row;
        justify-content: space-around;
        align-items: center;
    }

    .cataloge {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        text-transform: uppercase;
    }

    .main-nav ul {
        list-style: none;
        display: flex;
        align-items: center;
        gap: 2rem;
    }

    .main-nav a {
        text-decoration: none;
    }

    .main-nav li:hover {
        color: oklch(from var(--purple-text) l c h);
        transition: color 0.3s;
    }

    .configurator-button {
        display: flex;
        align-items: center;
        text-decoration: none;
    }

    .arrow-icon {
        margin-left: 5px;
        font-weight: bold;
        color: oklch(from var(--purple-text) l c h);
    }

    .user-controls {
        display: flex;
        align-items: center;
        gap: 3rem;
        font-size: 14px;
    }

    .user-controls img {
        cursor: pointer;
        display: block;
        align-items: center;
    }

    .search {
        position: relative;
        text-transform: uppercase;
    }

    .search::before {
        content: url("../assets/icons/Search.svg");
        position: absolute;
        top: 50%;
        left: 0.5rem;

        transform: translateY(-50%);

        width: 1rem;
        height: 1rem;
    }

    .search input {
        padding: 0.25rem 0.5rem 0.25rem 2rem;
        max-width: 6rem;
        font-size: 16px;
        border-radius: 0.1rem;
        font-family: "JetBrainsMono";
        text-transform: uppercase;
    }

    .search input::-webkit-search-cancel-button {
        display: none;
    }

    .user-collection {
        display: flex;
        flex-direction: row;
        gap: 1rem;
    }

    .info-catalog-wrapper {
        position: relative;
    }
    .info-catalog-wrapper span {
        text-transform: uppercase;
    }
    .info-catalog {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        padding: 0;
    }

    .info-menu {
        position: absolute;
        z-index: 3;
        padding: 1rem 2rem;
        min-width: 14.8125rem;

        color: oklch(from var(--body-text) l c h);
        background-color: oklch(from var(--bg) l c h);
        background-image: url(/src/assets/icons/main-pattern.svg);
        background-repeat: repeat;
        text-transform: uppercase;
        ul {
            list-style: none;
        }
    }
    .info-menu ul {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    body.modal-open {
        overflow: hidden;
    }

    .modal-overlay {
        inset: 0;
        background-color: oklch(from var(--bg) l c h);
        background-image: url(/src/assets/icons/main-pattern.svg);
        background-repeat: repeat;
        position: relative;
        z-index: 2;
        display: flex;
        align-items: stretch;
        justify-content: center;
    }

    .modal-window {
        width: 100vw;
        height: auto;
        display: flex;
    }

    .sidebar {
        border-right: 1px solid oklch(from var(--stroke) l c h);
        padding: 0;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
    }

    .sidebar ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .sidebar li {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 8px;
        cursor: pointer;
        color: oklch(from var(--text) l c h);
        font-size: 20px;
        transition: background 0.14s;
        border-left: 2px solid transparent;
    }

    .sidebar li .icon {
        width: 70px;
        height: 68px;
        border: 1px dashed oklch(from var(--light-stroke) l c h);
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .sidebar li.active,
    .sidebar li:hover {
        background: rgba(79, 74, 104, 0.11);
        color: oklch(from var(--purple-text) l c h);
    }

    .sidebar li.active span {
        color: oklch(from var(--purple-text) l c h);
    }

    .sidebar li .icon img {
        width: 43px;
        height: 50px;
        /* filter: grayscale(1) brightness(1.2) drop-shadow(0 0 3px #b085e770); */
    }

    .sidebar li.active .icon img {
        filter: none;
    }

    .modal-content {
        flex: 1 1 auto;
        padding: 44px 56px 44px 56px;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        overflow-y: auto;
    }

    .columns {
        display: flex;
        width: 100%;
    }

    .column {
        min-width: 270px;
        border-right: 1px dashed oklch(from var(--stroke) l c h);
        padding: 0 2rem;
    }

    .category-title {
        font-family: "JetBrainsMono";
        font-size: 20px;
        color: oklch(from var(--purple-text));
        background: linear-gradient(90deg, #e3c3fd 0%, #853ac2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        display: table;

        margin-bottom: 16px;
        text-transform: uppercase;
    }

    .category-group strong {
        display: block;
        font-size: 16px;
        margin: 18px 0 6px 0;
    }

    .category-group ul {
        padding-left: 14px;
        margin: 0 0 2px 0;
        list-style: none;
    }

    .category-group ul li {
        margin-bottom: 3px;
    }

    .purple-effect4 {
        overflow: hidden;
    }

    .purple-effect4::before {
        bottom: 0;
        top: -20%;
        right: -20%;
        width: 80%;
        height: 100%;
        transform: rotate(220deg);
        background-position: 0 70%;
        background-repeat: no-repeat;
    }

    /* mobile */
    .mobbile-menu {
        display: none;
    }
    @media (max-width: 1024px) {
        .mobbile-menu.active {
            display: block;
        }
        .mobbile-menu {
            display: flex;
            flex-direction: column;
        }
        .mobbile-menu ul {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
            font-size: 20px;
            list-style: none;
            padding-bottom: 1rem;
        }
    }
</style>
