            </li>
            <li><a href="">компания</a></li>
            <li><a href="">Акции</a></li>
            <li>
                <button type="button" class="btn info-catalog">
                    <span>.информация</span>
                    <img src="/src/assets/icons/OneArrowButton.svg" />
                </button>
            </li>
            <li><a href="">Контакты</a></li>
            <li><a href="">Конфигуратор ПК</a></li>
        </ul>
        <ul>
            <li>
                <a href="">
                    <div>
                        <img
                            src="/src/assets/icons/shopping-bag.svg"
                            alt="basket"
                        />
                        <span>Корзина</span>
                    </div>
                </a>
            </li>
            <li>
                <a href="">
                    <div>
                        <img src="/src/assets/icons/heart.svg" alt="favorite" />
