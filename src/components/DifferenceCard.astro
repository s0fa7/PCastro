---
import StarIcon from "../assets/images/return/StarIcon5.svg";
interface ReviewProps {
  number: string; // например: "001"
  title: string;
  text: string;
}

const { number, title, text } = Astro.props;
---

<div class="difference-container">
  <div class="column">
    <span class="number">{number}</span>
    <div class="review-icon angles-white">
      <StarIcon width={48} height={50} />
    </div>
  </div>
  <div class="column">
    <h4>{title}</h4>
    <p>{text}</p>
  </div>
</div>

<style>
  .difference-container {
    display: flex;
    width: 560px;
    height: 392px;
    padding: 54px 35px 34px 24px;
    margin: 1rem;

    background-image: url(/src/assets/images/ReviewBg.png);
    background-repeat: no-repeat;
    background-size: cover;
  }

  .column {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0 1rem;
    height: 100%;
  }

  .column:first-child {
    max-width: 135px;
    padding: 0;
    font-family: "JetBrainsMono";
    border-right: 1px dashed #ffffff80;
  }

  .number {
    text-transform: uppercase;
    width: 110px;
    position: relative;
    top: -10%;
    font-size: 1rem;
    color: oklch(from var(--grey-text) l c h);
    opacity: 0.8;
  }

  .column h4 {
    text-transform: uppercase;
    font-size: 28px;
    background-image: linear-gradient(90deg, #e3c3fd 0%, #853ac2 100%);
    color: transparent;
    background-clip: text;
    -webkit-background-clip: text;
  }

  .column p {
    font-weight: 600;
    font-size: 16px;
    line-height: 120%;
    font-family: "JetBrainsMono";
    color: #fff;
  }
  .review-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    width: 71px;
    height: 68px;
    border: 1px dashed #ffffff80;
  }
  .angles-white::before {
    z-index: 1;
  }
  @media (max-width: 1024px) {
    .difference-container {
      width: 343px;
      height: 262px;
      padding: 40px 12px 20px 13px;
    }
    .review-icon {
      width: 41px;
      height: 40px;
      padding: 6px;
    }
    .review-icon svg {
      width: 20px;
      height: 20px;
    }
    .column:first-child {
      max-width: 63px;
    }
    .number {
      width: 27px;
    }
    .column h4 {
      font-size: 16px;
    }
    .column p {
      font-size: 14px;
      overflow-y: scroll;
    }
  }
  @media (max-width: 350px) {
    .difference-container {
      width: 100%;
    }
    .review-icon {
      width: 31px;
      height: 30px;
      padding: 3px;
    }
  }
</style>
