                                <li>RX 7900 XTX / 7900 XT / 7900 GRE</li>
                                <li>RX 7800 XT</li>
                                <li>RX 7700 XT</li>
                                <li>RX 7600 XT / 7600</li>
                            </ul>
                            <strong>RADEON RX 6000-СЕРИИ</strong>
                            <ul>
                                <li>RX 6950 XT / 6900 XT</li>
                                <li>RX 6800 XT / 6800</li>
                                <li>RX 6750 XT / 6700 XT / 6700</li>
                                <li>RX 6650 XT / 6600 XT / 6600</li>
                            </ul>
                        </div>
                    </div>
                    <div class="column">
                        <h4 class="category-title">
                            Intel Arc (Новичок на рынке)
                        </h4>
                        <div class="category-group">
                            <ul>
                                <li>Arc A770</li>
                                <li>Arc A750</li>
                                <li>Arc A580</li>
                                <li>Arc A380</li>
                            </ul>
