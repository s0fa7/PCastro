                <div
                    class="columns"
                    data-category=".компьютеры"
                    style="display: none;"
                >
                    <div class="column">
                        <h4 class="category-title highlight">Игровые ПК</h4>
                        <ul>
                            <li>Бюджетные</li>
                            <li>Средний сегмент</li>
                            <li>Премиум</li>
                        </ul>
                    </div>
                </div>

                <!-- оперативная память -->
                <div
                    class="columns"
                    data-category=".оперативная память"
                    style="display: none;"
                >
                    <div class="column">
                        <h4 class="category-title highlight">DDR5</h4>
                        <ul>
                            <li>5200 MHz</li>
                            <li>6000 MHz</li>
                        </ul>
                        <h4 class="category-title">DDR4</h4>
                        <ul>
                            <li>3200 MHz</li>
                            <li>3600 MHz</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>

<script>
    //поиск

    // --- 1. ТЕСТОВЫЕ ДАННЫЕ И КОНСТАНТЫ ---
    interface SearchItem {
        id: number;
        title: string;
        description: string;
    }

    const SEARCH_DATA: SearchItem[] = [
        {
            id: 1,
            title: "Продукт А",
            description: "Лучший товар для десктопа.",
        },
        { id: 2, title: "Продукт Б", description: "Мобильный аксессуар." },
        { id: 3, title: "Услуга В", description: "Полезный сервис." },
        { id: 4, title: "Категория Г", description: "Поиск по категориям." },
    ];

    const MOBILE_MAX_WIDTH = 1024;
    const DROPDOWN_SELECTOR = ".results-dropdown";
    const MOBILE_DROPDOWN_ATTR = "data-mobile";
    const DESKTOP_DROPDOWN_ATTR = "data-desktop";
    const ACTIVE_CLASS = "is-active"; // <-- Новый класс для стилизации

    // --- 2. УТИЛИТЫ ---

    function isMobileView(): boolean {
        const isMobile = window.matchMedia(
            `(max-width: ${MOBILE_MAX_WIDTH}px)`,
        ).matches;
        return isMobile;
    }

    function getActiveDropdown(): HTMLElement | null {
        const isMobile = isMobileView();
        const attr = isMobile ? MOBILE_DROPDOWN_ATTR : DESKTOP_DROPDOWN_ATTR;
        const selector = `${DROPDOWN_SELECTOR}[${attr}]`;
        const dropdown = document.querySelector<HTMLElement>(selector);

        return dropdown;
    }

    // --- 3. ФУНКЦИИ РЕНДЕРИНГА И ФИЛЬТРАЦИИ ---

    function renderResults(
        results: SearchItem[],
        dropdownElement: HTMLElement,
    ): void {
        if (results.length === 0) {
            dropdownElement.innerHTML =
                '<div class="no-results">Ничего не найдено.</div>';
            return;
        }

        const html = results
            .map(
                (item) => `
        <div class="result-item">
            <strong>${item.title}</strong>
            <p>${item.description}</p>
        </div>
    `,
            )
            .join("");

        dropdownElement.innerHTML = html;
    }

    /**
     * Обрабатывает ввод и управляет видимостью + контентом дропдауна.
     */
    function filterResults(query: string): void {
        const trimmedQuery = query.trim().toLowerCase();
        const activeDropdown = getActiveDropdown();

        if (!activeDropdown) {
            console.error("[filterResults] Активный дропдаун НЕ НАЙДЕН!");
            return;
        }

        const shouldShow = trimmedQuery.length > 0;

        // --- Управление видимостью через КЛАСС ---
        if (shouldShow) {
            activeDropdown.classList.add(ACTIVE_CLASS);
        } else {
            activeDropdown.classList.remove(ACTIVE_CLASS);
        }

        // Скрываем другой дропдаун, удаляя класс
        const otherDropdown = document.querySelector<HTMLElement>(
            isMobileView()
                ? `${DROPDOWN_SELECTOR}[${DESKTOP_DROPDOWN_ATTR}]`
                : `${DROPDOWN_SELECTOR}[${MOBILE_DROPDOWN_ATTR}]`,
        );
        if (otherDropdown) {
            otherDropdown.classList.remove(ACTIVE_CLASS);
        }

        if (shouldShow) {
            // Фильтрация данных
            const filteredResults = SEARCH_DATA.filter(
                (item) =>
                    item.title.toLowerCase().includes(trimmedQuery) ||
                    item.description.toLowerCase().includes(trimmedQuery),
            );
            renderResults(filteredResults, activeDropdown);
        } else {
            // Если запрос пуст, очищаем содержимое
            activeDropdown.innerHTML = "";
        }
    }

    // --- 4. ИНИЦИАЛИЗАЦИЯ ---

    function setupDropdownLogic() {
        // 1. Присваиваем функцию глобальному объекту
        (window as any).filterResults = filterResults;

        // 2. Добавляем слушателя на изменение размера окна
        const mediaQuery = window.matchMedia(
            `(max-width: ${MOBILE_MAX_WIDTH}px)`,
        );
        mediaQuery.addEventListener("change", () => {
            const input = document.querySelector<HTMLInputElement>(".search");
            if (input) {
                filterResults(input.value);
            } else {
                console.warn(
                    "[mediaQuery] Поле поиска не найдено при изменении размера.",
                );
            }
        });

        // 3. Устанавливаем начальное состояние
        const initialInput =
            document.querySelector<HTMLInputElement>(".search");
        if (initialInput) {
            // Убедимся, что при загрузке оба дропдауна не активны
            const allDropdowns =
                document.querySelectorAll<HTMLElement>(DROPDOWN_SELECTOR);
            allDropdowns.forEach((d) => d.classList.remove(ACTIVE_CLASS));

            filterResults(initialInput.value);
        } else {
            console.error(
                "[setupDropdownLogic] Ошибка: Поле поиска (.search) не найдено!",
            );
        }
    }

    // Запуск инициализации
    document.addEventListener("DOMContentLoaded", setupDropdownLogic);

    //информация появление

    document.addEventListener("click", toggleDropdown);

    function toggleDropdown(e: MouseEvent): void {
        toggle(e, ".info-catalog", ".info-menu");
        toggle(e, ".phone-catalog", ".phone-menu-bottom");
    }

    function toggle(
        e: MouseEvent,
        watchedElementClass: string,
        toggledElementClass: string,
    ): void {
        const watchedElement = document.querySelector(watchedElementClass);
        const toggledElement = document.querySelector(toggledElementClass);

        if (!watchedElement || !toggledElement) return;

        if (watchedElement.contains(e.target as Node)) {
            const isHidden = toggledElement
                .getAttribute("style")
                ?.includes("none");
            toggledElement.setAttribute(
                "style",
                isHidden ? "display: block;" : "display: none;",
            );
        } else {
            toggledElement.setAttribute("style", "display: none;");
        }
    }

    //категории появление

    const infoMenuModal = document.querySelector(
        ".modal-overlay",
    ) as HTMLDivElement | null;

    document.querySelector(".cataloge")?.addEventListener("click", showMenu);

    function showMenu(): void {
        if (infoMenuModal && headerContainer) {
            const isModalHidden = infoMenuModal.style.display === "none";

            if (isModalHidden) {
                infoMenuModal.style.display = "flex";
                const headerRect: DOMRect =
                    headerContainer.getBoundingClientRect();
                const headerBottom: number = headerRect.bottom;

                infoMenuModal.style.top = `${headerBottom}px`;
                infoMenuModal.style.height = `calc(100vh - ${headerBottom}px)`;
            } else {
                infoMenuModal.style.display = "none";
            }
        }
    }

    //категории смена

    document.addEventListener("DOMContentLoaded", () => {
        const sidebarItems =
            document.querySelectorAll<HTMLLIElement>(".sidebar ul li");
        const allColumns = document.querySelectorAll<HTMLDivElement>(
            ".modal-content .columns",
        );

        sidebarItems.forEach((item) => {
            item.addEventListener("click", () => {
                sidebarItems.forEach((li) => li.classList.remove("active"));
                item.classList.add("active");

                const categoryName = item
                    .querySelector("span:last-child")
                    ?.textContent?.trim();
                if (!categoryName) return;

                allColumns.forEach((col) => {
                    if (col.dataset.category === categoryName) {
                        col.style.display = "flex";
                    } else {
                        col.style.display = "none";
                    }
                });
            });
        });
    });

    const burgerButton = document.getElementById(
        "burger",
    ) as HTMLButtonElement | null;
    const mobileMenu = document.getElementById(
        "mobile-menu",
    ) as HTMLDivElement | null;
    const headerContainer = document.querySelector(
        ".header-container",
    ) as HTMLElement | null;

    const menuIconHtml: string = `<svg width="24" height="24" viewBox="0 0 24 24" class="burger-icon-svg"><rect x="3" y="3" width="6" height="6" rx="3" fill="#9D4EDD"/>
<rect x="15" y="3" width="6" height="6" rx="3" fill="#9D4EDD"/>
<rect x="15" y="15" width="6" height="6" rx="3" fill="#9D4EDD"/>
<rect x="3" y="15" width="6" height="6" rx="3" fill="#9D4EDD"/></svg>`;
    const closeIconHtml: string = `<svg width="24" height="24" viewBox="0 0 24 24" class="burger-icon-svg"><g clip-path="url(#clip0_944_7643)">
<path d="M4.5664 3.99998L9.74841 8.51035C10.1915 8.89604 10.4427 9.45705 10.4352 10.0445L10.4134 11.752C10.407 12.2495 10.2155 12.7268 9.87607 13.0906L5.35182 17.941" stroke="#B860FF" stroke-width="2"/>
<path d="M19.543 3.99998L14.361 8.51035C13.9178 8.89604 13.6667 9.45705 13.6742 10.0445L13.696 11.752C13.7023 12.2495 13.8939 12.7268 14.2333 13.0906L18.7575 17.941" stroke="#B860FF" stroke-width="2"/>
</g>
<defs>
<clipPath id="clip0_944_7643">
<rect width="24" height="24" fill="white"/>
</clipPath>
</defs></svg>`;

    if (burgerButton) {
        burgerButton.innerHTML = menuIconHtml;
    }

    burgerButton?.addEventListener("click", () => {
        if (mobileMenu && burgerButton && headerContainer) {
            const headerRect: DOMRect = headerContainer.getBoundingClientRect();
            const headerBottom: number = headerRect.bottom;

            mobileMenu.style.top = `${headerBottom}px`;

            mobileMenu.classList.toggle("active");
            if (mobileMenu.classList.contains("active")) {
                burgerButton.innerHTML = closeIconHtml;
                document.body.style.overflow = "hidden";
            } else {
                burgerButton.innerHTML = menuIconHtml;
                document.body.style.overflow = "";
            }
        }
    });

    // мобильные подменю
    const setupMenuToggle = (
        triggerSelector: string,
        menuSelector: string,
    ): void => {
        const trigger = document.querySelector(
            triggerSelector,
        ) as HTMLElement | null;
        const menu = document.querySelector(menuSelector) as HTMLElement | null;

        if (trigger && menu) {
            trigger.addEventListener("click", (event: MouseEvent) => {
                event.preventDefault();

                menu.classList.toggle("hidden");
            });
        } else {
            if (!trigger) {
                console.warn(
                    `[Debug] ОШИБКА: Триггер не найден: ${triggerSelector}`,
                );
            }
            if (!menu) {
                console.warn(
                    `[Debug] ОШИБКА: Меню не найдено: ${menuSelector}`,
                );
            }
        }
    };

    document.addEventListener("DOMContentLoaded", () => {
        setupMenuToggle(".mobbile-cataloge", ".mobbile-product-cataloge");
        setupMenuToggle(".mobbile-phone-number", ".mobbile-phone-menu-bottom");
        setupMenuToggle(".mobbile-info-catalog", ".mobbile-info-menu");
    });

    // мобильный каталог переключение
    document.addEventListener("DOMContentLoaded", () => {
        // Находим все родительские 'li' элементы
        // (Предполагаем, что они все в одном 'ul')
        const allListItems = document.querySelectorAll<HTMLLIElement>(
            ".mobbile-catologe-item",
        );
        const parentUl =
            allListItems.length > 0 ? allListItems[0].closest("ul") : null;

        if (!parentUl) {
            console.warn("Не удалось найти список UL для каталога.");
            return;
        }

        const allLis = parentUl.querySelectorAll<HTMLLIElement>(":scope > li");

        // --- 1. Инициализация (скрываем все неактивные) ---

        allLis.forEach((li) => {
            const submenu = li.querySelector<HTMLElement>(
                ".mobbile-catologe-item-info",
            );
            if (!submenu) return; // Пропускаем 'li' без подменю (как у "блока питания")

            if (li.classList.contains("active")) {
                // Если активен по умолчанию (как "видеокарты"),
                // принудительно его показываем
                submenu.style.display = "block";
            } else {
                // Если не активен, принудительно его скрываем
                submenu.style.display = "none";
            }
        });

        // --- 2. Настройка кликов (логика аккордеона) ---

        allLis.forEach((currentLi) => {
            const trigger = currentLi.querySelector<HTMLElement>(
                ".mobbile-catologe-item",
            );
            const currentSubmenu = currentLi.querySelector<HTMLElement>(
                ".mobbile-catologe-item-info",
            );

            // Вешаем клик только на 'li', у которых есть и триггер, и подменю
            if (!trigger || !currentSubmenu) {
                return;
            }

            trigger.addEventListener("click", (event: MouseEvent) => {
                event.preventDefault();

                // Проверяем, был ли этот элемент УЖЕ активен
                const wasActive = currentLi.classList.contains("active");

                // Сначала скрываем ВСЕ подменю и убираем ВСЕ классы 'active'
                allLis.forEach((li) => {
                    li.classList.remove("active");
                    const submenu = li.querySelector<HTMLElement>(
                        ".mobbile-catologe-item-info",
                    );
                    if (submenu) {
                        submenu.style.display = "none";
                    }
                });

                // Если элемент не был активен (т.е. мы его открываем)
                if (!wasActive) {
                    // Добавляем класс и показываем подменю
                    currentLi.classList.add("active");
                    currentSubmenu.style.display = "block";
                }
                // Если элемент был активен (wasActive === true),
                // то мы его уже закрыли на предыдущем шаге,
                // и ничего больше делать не нужно.
            });
        });
    });
</script>

