                    </div>
                </div>
                <!-- процессоры -->
                <div
                    class="columns"
                    data-category=".процессоры"
                    style="display: none;"
                >
                    <div class="column">
                        <h4 class="category-title highlight">Intel</h4>
                        <ul>
                            <li>Core i9</li>
                            <li>Core i7</li>
                            <li>Core i5</li>
                        </ul>
                    </div>
                    <div class="column">
                        <h4 class="category-title">AMD</h4>
                        <ul>
                            <li>Ryzen 9</li>
                            <li>Ryzen 7</li>
                            <li>Ryzen 5</li>
                        </ul>
                    </div>
                </div>

                <!-- материнские платы -->
                <div
                    class="columns"
                    data-category=".материнские платы"
                    style="display: none;"
                >
                    <div class="column">
                        <h4 class="category-title highlight">Intel</h4>
                        <ul>
                            <li>Z790 / B760 / H610</li>
                        </ul>
                    </div>
                    <div class="column">
                        <h4 class="category-title">AMD</h4>
                        <ul>
                            <li>X670 / B650 / A620</li>
                        </ul>
                    </div>
                </div>

                <!-- компьютеры -->
                <div
                    class="columns"
                    data-category=".компьютеры"
                    style="display: none;"
                >
                    <div class="column">
                        <h4 class="category-title highlight">Игровые ПК</h4>
                        <ul>
                            <li>Бюджетные</li>
                            <li>Средний сегмент</li>
                            <li>Премиум</li>
                        </ul>
                    </div>
                </div>

                <!-- оперативная память -->
                <div
                    class="columns"
                    data-category=".оперативная память"
                    style="display: none;"
                >
                    <div class="column">
                        <h4 class="category-title highlight">DDR5</h4>
                        <ul>
                            <li>5200 MHz</li>
                            <li>6000 MHz</li>
                        </ul>
                        <h4 class="category-title">DDR4</h4>
                        <ul>
                            <li>3200 MHz</li>
                            <li>3600 MHz</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        //информация появление

        document.addEventListener("click", toggleDropdown);

        function toggleDropdown(e: MouseEvent): void {
            toggle(e, ".info-catalog", ".info-menu");
            toggle(e, ".phone-catalog", ".phone-menu-bottom");
        }

        function toggle(
            e: MouseEvent,
            watchedElementClass: string,
            toggledElementClass: string,
        ): void {
            const watchedElement = document.querySelector(watchedElementClass);
            const toggledElement = document.querySelector(toggledElementClass);

            if (!watchedElement || !toggledElement) return;

            if (watchedElement.contains(e.target as Node)) {
                const isHidden = toggledElement
                    .getAttribute("style")
                    ?.includes("none");
                toggledElement.setAttribute(
                    "style",
                    isHidden ? "display: block;" : "display: none;",
                );
            } else {
                toggledElement.setAttribute("style", "display: none;");
            }
        }

        //категории появление

        const infoMenuModal = document.querySelector(
            ".modal-overlay",
        ) as HTMLDivElement | null;

        document
            .querySelector(".cataloge")
            ?.addEventListener("click", showMenu);

        function showMenu(): void {
            if (infoMenuModal && headerContainer) {
                const isModalHidden = infoMenuModal.style.display === "none";

                if (isModalHidden) {
                    infoMenuModal.style.display = "flex"; 
                    const headerRect: DOMRect =
                        headerContainer.getBoundingClientRect();
                    const headerBottom: number = headerRect.bottom;

                    infoMenuModal.style.top = `${headerBottom}px`;
                    infoMenuModal.style.height = `calc(100vh - ${headerBottom}px)`;
                } else {
                    infoMenuModal.style.display = "none";
                }
            }
        }

        //категории смена

        document.addEventListener("DOMContentLoaded", () => {
            const sidebarItems =
                document.querySelectorAll<HTMLLIElement>(".sidebar ul li");
            const allColumns = document.querySelectorAll<HTMLDivElement>(
                ".modal-content .columns",
            );

            sidebarItems.forEach((item) => {
                item.addEventListener("click", () => {
                    sidebarItems.forEach((li) => li.classList.remove("active"));
                    item.classList.add("active");

                    const categoryName = item
                        .querySelector("span:last-child")
                        ?.textContent?.trim();
                    if (!categoryName) return;

                    allColumns.forEach((col) => {
                        if (col.dataset.category === categoryName) {
                            col.style.display = "flex";
                        } else {
                            col.style.display = "none";
                        }
                    });
                });
            });
        });

        const burgerButton = document.getElementById(
            "burger",
        ) as HTMLButtonElement | null;
        const mobileMenu = document.getElementById(
            "mobile-menu",
        ) as HTMLDivElement | null;
        const headerContainer = document.querySelector(
            ".header-container",
        ) as HTMLElement | null;

        const menuIconHtml: string = `<svg width="24" height="24" viewBox="0 0 24 24" class="burger-icon-svg"><rect x="3" y="3" width="6" height="6" rx="3" fill="#9D4EDD"/>
<rect x="15" y="3" width="6" height="6" rx="3" fill="#9D4EDD"/>
<rect x="15" y="15" width="6" height="6" rx="3" fill="#9D4EDD"/>
<rect x="3" y="15" width="6" height="6" rx="3" fill="#9D4EDD"/></svg>`;
        const closeIconHtml: string = `<svg width="24" height="24" viewBox="0 0 24 24" class="burger-icon-svg"><g clip-path="url(#clip0_944_7643)">
<path d="M4.5664 3.99998L9.74841 8.51035C10.1915 8.89604 10.4427 9.45705 10.4352 10.0445L10.4134 11.752C10.407 12.2495 10.2155 12.7268 9.87607 13.0906L5.35182 17.941" stroke="#B860FF" stroke-width="2"/>
<path d="M19.543 3.99998L14.361 8.51035C13.9178 8.89604 13.6667 9.45705 13.6742 10.0445L13.696 11.752C13.7023 12.2495 13.8939 12.7268 14.2333 13.0906L18.7575 17.941" stroke="#B860FF" stroke-width="2"/>
</g>
<defs>
<clipPath id="clip0_944_7643">
<rect width="24" height="24" fill="white"/>
</clipPath>
</defs></svg>`;

        if (burgerButton) {
            burgerButton.innerHTML = menuIconHtml;
        }

        burgerButton?.addEventListener("click", () => {
            if (mobileMenu && burgerButton && headerContainer) {
                const headerRect: DOMRect =
                    headerContainer.getBoundingClientRect();
                const headerBottom: number = headerRect.bottom;

                mobileMenu.style.top = `${headerBottom}px`;

                mobileMenu.classList.toggle("active");
                if (mobileMenu.classList.contains("active")) {
                    burgerButton.innerHTML = closeIconHtml; 
                    document.body.style.overflow = "hidden"; 
                } else {
                    burgerButton.innerHTML = menuIconHtml; 
                    document.body.style.overflow = ""; 
                }
            }
        });
    </script>

    <style>
        .header-container {
            width: 100%;
            font-family: "JetBrainsMono", sans-serif;
            font-size: 16px;
            text-transform: uppercase;
            position: relative;
            top: auto;
            left: auto;
            z-index: 3; /* Шапка всегда сверху, пока не прокрутится */
            border-bottom: 1px solid oklch(from var(--stroke) l c h); /* Добавляем тонкую линию под шапкой */
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 107.25rem;
            margin: 0 auto;
            padding: 22px 0;
        }

        .header-nav {
            max-width: 1305px;
            width: 70%;
            display: flex;
            flex-direction: row;
            justify-content: space-around;
            align-items: center;
        }

        .cataloge {
            display: flex;
            gap: 0.5rem;
            align-items: center;
            text-transform: uppercase;
        }

        .main-nav ul:not(.info-menu ul) {
            list-style: none;
            display: flex;
            align-items: center;
            gap: 2rem;
        }

        .main-nav a {
            text-decoration: none;
        }

        .main-nav li:hover {
            color: oklch(from var(--purple-text) l c h);
            transition: color 0.3s;
        }

        .configurator-button {
            display: flex;
            align-items: center;
            text-decoration: none;
        }

        .arrow-icon {
            margin-left: 5px;
            font-weight: bold;
            color: oklch(from var(--purple-text) l c h);
        }

        .user-controls {
            display: flex;
            align-items: center;
            gap: 3rem;
            font-size: 14px;
        }

        .user-controls img {
            cursor: pointer;
            display: block;
            align-items: center;
        }

        .search {
            position: relative;
            text-transform: uppercase;
        }

        .search::before {
            content: url("../assets/icons/Search.svg");
            position: absolute;
            top: 35%;
            left: 0.5rem;

            transform: translateY(-50%);

            width: 1rem;
            height: 1rem;
        }

        .search input {
            padding: 0 0.5rem 0 2rem;
            max-width: 6rem;
            font-size: 16px;
            border-radius: 0.1rem;
            font-family: "JetBrainsMono";
            text-transform: uppercase;
        }

        .search input::-webkit-search-cancel-button {
            display: none;
        }

        .user-collection {
            display: flex;
            flex-direction: row;
            gap: 1rem;
        }

        .info-catalog-wrapper {
            position: relative;
        }
        .info-catalog-wrapper span {
            text-transform: uppercase;
        }
        .info-catalog {
            display: flex;
            gap: 0.5rem;
            align-items: center;
            padding: 0;
            text-transform: uppercase;
        }

        .phone-menu-bottom {
            top: 100%;
            right: 0;
        }
        .info-menu,
        .phone-menu-bottom {
            position: absolute;
            z-index: 3;
            padding: 0.5rem 1rem;
            min-width: 14.8125rem;

            color: oklch(from var(--body-text) l c h);
            background-color: oklch(from var(--bg) l c h);
            background-image: url(/src/assets/icons/main-pattern.svg);
            background-repeat: repeat;
            text-transform: uppercase;
            ul {
                list-style: none;
            }
        }
        .info-menu ul,
        .phone-menu-bottom ul {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        body.modal-open {
            overflow: hidden;
        }

        .modal-overlay {
            position: absolute;
            left: 0;
            background-color: oklch(from var(--bg) l c h);
            background-image: url(/src/assets/icons/main-pattern.svg);
            background-repeat: repeat;
            z-index: 10;
            display: flex;
            overflow-y: auto;
        }

        .modal-window {
            width: 100vw;
            height: auto;
            display: flex;
        }

        .sidebar {
            border-right: 1px solid oklch(from var(--stroke) l c h);
            padding: 0;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
        }

        .sidebar ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .sidebar li {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 8px;
            cursor: pointer;
            color: oklch(from var(--text) l c h);
            font-size: 20px;
            transition: background 0.14s;
            border-left: 2px solid transparent;
        }

        .sidebar li .icon {
            width: 70px;
            height: 68px;
            border: 1px dashed oklch(from var(--light-stroke) l c h);
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sidebar li.active,
        .sidebar li:hover {
            background: rgba(79, 74, 104, 0.11);
            color: oklch(from var(--purple-text) l c h);
        }

        .sidebar li.active span {
            color: oklch(from var(--purple-text) l c h);
        }

        .sidebar li .icon img {
            width: 43px;
            height: 50px;
            /* filter: grayscale(1) brightness(1.2) drop-shadow(0 0 3px #b085e770); */
        }

        .sidebar li.active .icon img {
            filter: none;
        }

        .modal-content {
            flex: 1 1 auto;
            padding: 44px 56px 44px 56px;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            overflow-y: auto;
        }

        .columns {
            display: flex;
            width: 100%;
        }

        .column {
            min-width: 270px;
            border-right: 1px dashed oklch(from var(--stroke) l c h);
            padding: 0 2rem;
        }

        .category-title {
            font-family: "JetBrainsMono";
            font-size: 20px;
            color: oklch(from var(--purple-text));
            background: linear-gradient(90deg, #e3c3fd 0%, #853ac2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: table;

            margin-bottom: 16px;
            text-transform: uppercase;
        }

        .category-group strong {
            display: block;
            font-size: 16px;
            margin: 18px 0 6px 0;
        }

        .category-group ul {
