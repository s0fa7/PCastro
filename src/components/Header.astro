                    </span>
                    <div class="phone-menu-bottom" style="display: none">
                        <ul>
                            <li>новости</li>
                            <li>Доставка и оплата</li>
                            <li>Гарантия и возврат</li>
                        </ul>
                    </div>
                </button>
            </div>
            <button type="button" class="burger phone-menu" id="burger">
                <Menu width={17} height={17} class="burger-icon-svg" />
            </button>
        </div>
        <div class="mobile-menu" id="mobile-menu">
            <ul>
                <li>
                    <button type="button" class="btn cataloge">
                        <img src="/src/assets/icons/Catalog.svg" />
                        <span>каталог</span>
