                                alt="basket"
                            />
                            <span>Корзина</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="">
                        <div>
                            <img
                                src="/src/assets/icons/heart.svg"
                                alt="favorite"
                            />
                            <span>избранное</span>
                        </div>
                    </a>
                </li>
                <li>
                    <div class="search">
