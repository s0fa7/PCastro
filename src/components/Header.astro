            <Phone width={17} height={17} />
        </a>
        <div class="header-nav">
            <a href="#" class="logo">
                <img src="src/assets/Srf.svg" />
            </a>
            <button type="button" class="btn cataloge desktop-only">
                <img src="/src/assets/icons/Catalog.svg" />
                <span>каталог</span>
            </button>
            <nav class="main-nav desktop-only">
                <ul>
                    <li><a href="#">.компания</a></li>
                    <li><a href="#">.акции</a></li>
                    <li>
                        <div class="info-catalog-wrapper">
                            <button type="button" class="btn info-catalog">
                                <span>.информация</span>
                                <img
                                    src="/src/assets/icons/OneArrowButton.svg"
                                />
                            </button>
                            <div class="info-menu" style="display: none">
                                <ul>
                                    <li>новости</li>
                                    <li>Доставка и оплата</li>
                                    <li>Гарантия и возврат</li>
